@using Fanex.Nap.CMS.Infrastructure.Extensions;
@{
    ViewBag.Title = "VR Auto Adjustment Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime currentDate = DateTime.Today;
}
@section Head {
    @Styles.Render("~/bundles/VrAutoAdjustmentReport/css")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}


@using (Html.BeginForm("", "", FormMethod.Post, new { id = "", @class = "filter-bar", area = "" }))
{
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_4">
                <label>Updated Date</label>
            </div>
            <div id="fromtodate-picker"></div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit">Generate</button>
            </div>
        </div>
    </div>
}


<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>

<div id="divModals" class="display-none">
    <div class="form expand-form">
        <div class="">
            Hung Cuong
        </div>
        <div class="form-row button-row">
            <button type="button" class="red-button" onclick="CMS.closePopup()">Close</button>
        </div>
    </div>
</div>

@section Foot {
    <script type="text/javascript">
        var currentDate = '@currentDate.ToShortFormatedDateWithSlash()';
        var initFromDate = currentDate;
    </script>
    @Scripts.Render("~/bundles/VrAutoAdjustmentReport/js")
}