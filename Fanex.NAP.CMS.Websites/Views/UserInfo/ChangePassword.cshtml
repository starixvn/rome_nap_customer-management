@using Fanex.NAP.Core.Web
@using Fanex.NAP.CMS.Core.Resources
@{
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <input type ="hidden" id="hdnToken" name="token" value="@ViewBag.ChangePasswordToken" />
    <div class="form w120 user-control" id="divPassword">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="txtOldPassword">@ViewResources.Old_Password</label>
            </div>
            <div class="edit-field">
                <input type="password"
                       id="txtOldPassword"
                       data-val-required="@Messages.RequiredFieldError"
                       data-val-length="@Messages.PasswordMinLengthError"
                       data-min-length="5" />
                <input type="hidden" id="hdnOldPassword" name="OldUserPwd" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="txtNewPassword">@ViewResources.New_Password</label>
            </div>
            <div class="edit-field">
                <input type="password"
                       id="txNewPassword"
                       data-val-required="@Messages.RequiredFieldError"
                       data-val-length="@Messages.PasswordMinLengthError"
                       data-min-length="5" />
                <input type="hidden" id="hdnNewPassword" name="UserPwd" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="txtConfirmPassword">@ViewResources.Confirm_Password</label>
            </div>
            <div class="edit-field">
                <input type="password"
                       id="txtConfirmPassword"
                       data-val-required="@Messages.RequiredFieldError"
                       data-val-length="@Messages.PasswordMinLengthError"
                       data-min-length="5"
                       data-val-not-match="@Messages.PasswordDoesNotMatch" />
                <input type="hidden" id="hdnConfirmPassword" name="ConfirmUserPwd" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                <input type="submit" id="btnSubmit" value="@ViewResources.Save" class="blue-button" />
                <input type="button" value="Cancel" onclick="CMS.navigateToRoot('', 0); return false;" class="red-button"/>
            </div>
        </div>
    </div>
}
@section Foot {
    @Scripts.Render("~/scripts/crypto")
    <script type="text/javascript">
        var isSuccess = '@success' === 'True';
        var message = '@message';
        var form = $('#divPassword');
        var oldPassword = form.find('#txtOldPassword');
        var newPassword = form.find('#txNewPassword');
        var confirmPassword = form.find('#txtConfirmPassword');
        var msgArea = $('#divErrorSuccessMsg', form);

        var validateMatchedPass = function () {
            var err = confirmPassword.attr('data-val-not-match');

            if (newPassword.val() !== confirmPassword.val()) {
                Validator.showError(confirmPassword, err, 'w');
                return false;
            } else {
                return true;
            }
        };

        $(function () {
            if (isSuccess) {
                CMS.showInlineSuccessMsg('@ViewResources.Your_changes_were_saved!', msgArea);
            } else if (message !== '') {
                CMS.showInlineErrorMsg(message, msgArea);
            }

            form.find('#btnSubmit').click(function () {
                var encryptPass = '';
                var token = $('#hdnToken').val();

                if (!Validator.validateForm(form, 'w')) {
                    return false;
                } else if (!validateMatchedPass()) {
                    return false;
                }

                encryptPass = CryptoJS.CfsEnCode(oldPassword.val());
                $('#hdnOldPassword').val(CryptoJS.SHA256(encryptPass + token));

                encryptPass = CryptoJS.CfsEnCode(newPassword.val());
                $('#hdnNewPassword').val(encryptPass);

                encryptPass = CryptoJS.CfsEnCode(confirmPassword.val());
                $('#hdnConfirmPassword').val(encryptPass);
            });
        });
    </script>
}