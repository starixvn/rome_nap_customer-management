@using Fanex.Nap.CMS.PayoutManagement.Models.API
@model MicrogamingResult

<div class="form expand-form div-microgaming">
    @if (Model == null || Model.ReturnCode != 0)
    { 
        <p>@Model.ReturnMessage</p>
    }
    else
    {
        <iframe src="@HttpContext.Current.Server.UrlDecode(Model.URL)"></iframe>     
    }
</div>