@using Fanex.Nap.CMS.TurnoverControl.AppStart;
@using Fanex.Nap.CMS.TurnoverControl.Resources;
@using Fanex.Nap.CMS.Infrastructure.Extensions;
@using Fanex.Nap.CMS.Infrastructure.Web;
@using Fanex.Nap.CMS.Infrastructure.Configurations
@{
    ViewBag.Title = Labels.Turnover_Monitor;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool hasHostPermission = Convert.ToBoolean(ViewData["HostPermission"]);
}
@section Head
{
    @Styles.Render(TurnoverControlBundleConfig.TurnoverMonitorStyles)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    @using (Html.BeginForm("GetCustomerTurnovers", "TurnoverMonitor", FormMethod.Get, new { id = "formTurnoverMonitor", @class = "filter-form" }))
    {
        <div class="filter-row">
            <div id="fromtodate-picker"></div>
            <div class="lbl-field col_4 col_sport">
                <label>@Labels.Sport</label>
            </div>
            <div class="edit-field col_11">
                <select id="ddl-sport" class="combobox-autocomplete ddl-sport"></select>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label>@Labels.League</label>
            </div>
            <div class="edit-field col_15">
                <select id="ddl-league" class="combobox-autocomplete ddl-league"></select>
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.Match</label>
            </div>
            <div class="edit-field col_11">
                <select id="ddl-match" class="combobox-autocomplete ddl-match"></select>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txt-percentageused">@Labels.Symbol_PercentageUsedFilter</label>
            </div>
            <div class="edit-field col_4">
                <input type="text" id="txt-percentageused" value="@(AppSettings.TurnoverPercentageUsed)" autocomplete="off" maxlength="3" />
            </div>
            <div class="lbl-field col_3">
                <label for="txt-username">@Labels.UserName</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txt-username" autocomplete="off" maxlength="30"/>
            </div>
            <div class="lbl-field col_4">&nbsp;</div>
            <div class="edit-field col_1">
                <input type="checkbox" id="chk-excludecompletedevents" checked="checked" />
            </div>
            <div class="lbl-field col_6">
                <label for="chk-excludecompletedevents">@Labels.ExcludeCompletedEvents</label>
            </div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit">@Labels.Submit</button>
            </div>
        </div>
    }
</div>
<div class="content-box">
    <div id="div-result-message" class="inline-message"></div>
    <div id="div-smaturnover-grid-title" class="grid-title display-none">
        <div class="max-level-used-box">
            <table cellspacing="0">
                <tr>
                    <th class="lbl-max-level-used">
                        @Labels.TurnoverMonitor_MaxLevelReachedMessage
                    </th>
                    <th class="lbl-max-level-used-counter" id="lbl-max-level-used-counter">
                    </th>
                </tr>
            </table>
        </div>
    </div>
    @{ Html.RenderPartial("_CustomerTurnover", hasHostPermission); }
</div>
<div id="divPopupContent" class="display-none">
    <div id="divHouseTurnover" style="width: 805px;">
        <div id="house-turnover-list" class="freegrid display-none">
        </div>
    </div>
</div>

@section Foot
{
    <script type="text/javascript">
        var rootUrl = document.getElementById("CMSRoot").value;
        var currentDate = '@DateTime.Today.ToShortFormatedDate()';
        var minDate = '@(AppSession.BalanceUpDate.BalanceUpDay.ToShortFormatedDate())';
        var hasHostPermission = @hasHostPermission.ToString().ToLowerInvariant();
        var maxIntValue = @int.MaxValue;
        var viewResources = {
            From_Date: '@Labels.From_Date',
            Message_NoReportData:'@Labels.Message_NoReportData',
            Event_Date: '@Labels.Event_Date',
            Edit: '@Labels.Edit',
            GlobalSetting_EditMaxTurnover_Confirm:'@Labels.GlobalSetting_EditMaxTurnover_Confirm',
            Balance_Info: '@Labels.Balance_Info',
            Bet_Type: '@Labels.Bet_Type',
            Live: '@Labels.Live',
            NonLive: '@Labels.NonLive',
            Total: '@Labels.Total',
            TurnoverMonitor_CompanyTurnover_Title: '@Labels.TurnoverMonitor_CompanyTurnover_Title',
            Error_RequiredField: '@Labels.Error_RequiredField',
            InvalidValueError: '@Fanex.NAP.CMS.Core.Resources.Messages.InvalidValueError',
            ExceedMaxTurnover: '@Labels.GlobalSetting_MaxTurnover_ExceedMaxTurnover',
            Error_NoActionOccured: '@Labels.Error_NoActionOccured'
        };
    </script>
    @Scripts.Render(TurnoverControlBundleConfig.TurnoverMonitorScripts)
}
