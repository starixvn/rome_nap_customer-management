@using Fanex.Nap.CMS.Customers.AppStart
@model Fanex.Nap.CMS.DefaultMemberBetLimit.Models.IndexViewModel
@{
                /**/

                ViewBag.Title = ViewLang.DefaultMemberBetLimit;
                Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render(CustomersBundlesConfig.DefaultMemberBetLimitStylePath)
}
@section Foot
{
    @Scripts.Render(CustomersBundlesConfig.DefaultMemberBetLimitScriptPath)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar" isHost="@ViewBag.IsHost.ToString()">
    <div id="divFilterForm" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_4">
                <label for="selectBetLimitType">@ViewLang.BetLimitType</label>
            </div>
            <div class="edit-field col_8">
                <select id="selectBetLimitType" class="ddl-select combobox-autocomplete">
                    <option value="0">@ViewLang.All</option>
                    @foreach (var betLimitType in Model.BetLimitTypes)
                    {
                        <option value="@betLimitType.BetLimitTypeId">@betLimitType.BetLimitType</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_3">
                <label for="selectUsername">@ViewLang.Username</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="selectUsername">
            </div>
            <div class="submit width-auto col_3">
                <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
    </div>
</div>
@if (ViewBag.IsHost)
{
    <div class="button-list clear-fix">
        <button type="button" class="blue-button" id="btnAdd">New Default Bet Limit</button>
    </div>
    <div id="div-popup" class="display-none">
        @Html.Partial("_Add", Model)
        @Html.Partial("_Update")
    </div>
}
<div class="display-none content-grid">
    <div id="grid" class="freegrid"></div>
</div>
<div class="content-grid">
    <span class="required-field">*</span> Note: Currently, Default Bet Limit can be applied for licensee members only.
</div>