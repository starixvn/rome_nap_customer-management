@{
    ViewBag.Title = ViewLang.ConfigureTOByEvent;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/configureTOByEvent")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        <a href="#" class="green-button change-list current"><span class="icon-list"></span>@ViewLang.Sport</a>
        <a href="#" class="green-button change-list"><span class="icon-list"></span>@ViewLang.League</a>
        <a href="#" class="green-button change-list"><span class="icon-list"></span>@ViewLang.Match</a>
    </div>
}

@section Foot
{
    @Scripts.Render("~/scripts/configureTOByEvent")
}