@using Fanex.NAP.CMS.BetLimitControl.Resources
@using ViewLang = Fanex.Nap.CMS.Infrastructure.Resources
@using Fanex.NAP.CMS.BetLimitControl.AppBundles;
@using Newtonsoft.Json

@model Fanex.NAP.CMS.BetLimitControl.ViewModels.BetLimitIncreaseViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.BetLimitIncrease;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}

@section Head {
    @Styles.Render(BetLimitBundlesConfig.BetLimitIncreaseStyles)
}

@section Foot {
    <script type="text/javascript">
        const resources = {
            username: "@Labels.Username",
            site: "@Labels.Site",
            currency: "@Labels.Currency",
            multiplier: "@Labels.Multiplier",
            addBy: "@Labels.AddBy",
            addDate: "@Labels.AddDate",
            requiredField: "@Labels.RequiredField",
            invalidValueError: "@Labels.InvalidValueError",
            invalidMinRangeError: "@Labels.InvalidMinRangeMultiplier",
            invalidMaxRangeError: "@Labels.InvalidMaxRangeMultiplier",
            addBetLimitIncrease: "Add New",
            editBetLimitIncrease: "Edit"
        };

        const siteList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Sites, jsonSettings))');
        const currencyList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Currencies, jsonSettings))');
    </script>
    @Scripts.Render(BetLimitBundlesConfig.BetLimitIncreaseScripts)
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="filter-bar">
    @using (Html.BeginForm("Search", "BetLimitIncrease", FormMethod.Post, new { @class = "filter-form", id = "formSearch" }))
    {
        <input type="text" style="display:none" autocomplete="false">
        <div class="filter-row first-row">
            <div class="lbl-field col_4">
                <label>@Labels.Username</label>
            </div>
            <div class="edit-field col_5">
                <input type="text" id="txtFilterUsername" autocomplete="off" />
            </div>
            <div class="lbl-field col_2">
                <label>@Labels.Site</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddl-site" class="ddl-select combobox-autocomplete">
                    <option value="0">@ViewLang.Labels.All</option>
                    @foreach (var site in Model.Sites)
                    {
                        <option value="@site.Id">@site.Name</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_4">
                <label>@Labels.Currency</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddl-currency" class="ddl-select combobox-autocomplete">
                    <option value="0">@ViewLang.Labels.All</option>
                    @foreach (var cur in Model.Currencies)
                    {
                        <option value="@cur.Id">@cur.Name</option>
                    }
                </select>
            </div>
            <div class="submit width-auto">
                <button type="submit" class="submit">@Labels.Search</button>
                @if (Model.HasHostPermission)
                {
                    <button type="button" class="blue-button" id="btnAddNew">@Labels.AddNew</button>
                }
            </div>
        </div>
    }
</div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>

@if (Model.HasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @{ Html.RenderPartial("~/Areas/BetLimitIncrease/Views/_AddEditBetLimitIncrease.cshtml", Model); }
    </div>
}
