@using Fanex.NAP.CMS.Core.Resources
@using Fanex.Nap.CMS.Infrastructure.Extensions;
@model string
@{
    ViewBag.Title = "Soccer Virtual Rate Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime currentDate = DateTime.Today;
}
@section Head
{
    @Styles.Render("~/bundles/virtual-rate-details/index-styles")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div class="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txt-username">@ViewLang.Account</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txt-username" class="txt-username" maxlength="50" />
            </div>
            <div class="submit width-auto col_4">
                <input id="btn-search" type="button" class="submit" value="@ViewLang.Search" />
            </div>
            <div class="lbl-field col_4">
                <label for="chk-include-upline">@ViewLang.IncludingUpline</label>
            </div>
            <div class="edit-field col_1 div-include-upline">
                <input type="checkbox" id="chk-include-upline" />
            </div>
            <div id="fromtodate-picker"></div>
        </div>
    </div>
</div>
<div id="report-container" class="display-none">
    <div class="content-grid">
        <div id="virtual-rate-report-freegrid-grid-title" class="grid-title">
            <div class="grid-title-label" id="report-tile">@ViewLang.VirtualRateDetails</div>
            <div class="grid-toolbox">
                <div class="div-curreny">@ViewLang.Currency <span class="lbl-curreny"></span></div>
            </div>
        </div>
        <table id="tbl-virtual-rate-report" class="tbl-report">
            <thead>
                <tr>
                    <th class="col-group">
                        <span id="ico-collapse" class="ico-collapse"></span>
                    </th>
                    <th class="col-nonlive">
                        @ViewLang.NonLive
                    </th>
                    <th class="col-live">
                        @ViewLang.Live
                    </th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section Foot
{
    <script type="text/javascript">
        var currentDate = '@currentDate.ToShortFormatedDateWithSlash()',
            initFromDate = '@currentDate.AddDays(-1).ToShortFormatedDateWithSlash()';
        var resources = {
            From: '@ViewLang.From',
            To: '@ViewLang.To',
            RequiredField: '@ViewLang.RequiredField',
            FollowOldVR: '@ViewLang.FollowOldVR',
            FollowUpline: '@ViewLang.FollowUpline',
            FollowParent: '@ViewLang.FollowParent',
            Currency: '@ViewLang.Currency',
            Message_NoReportData: '@Fanex.Nap.CMS.Infrastructure.Resources.Labels.Message_NoReportData',
            InvalidAccounts: '@ViewLang.InvalidAccounts',
            VirtualRateLog: '@ViewLang.VirtualRateLog',
            Update: '@ViewLang.Update',
            By: '@ViewLang.By',
            ExchangeRate: '@ViewLang.ExchangeRate',
            SportType: 1
        };
    </script>
    @Scripts.Render("~/bundles/virtual-rate-details/viewlog")
}
