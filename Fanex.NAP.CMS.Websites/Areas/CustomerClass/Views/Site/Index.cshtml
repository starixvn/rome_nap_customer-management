@using Newtonsoft.Json
@using Fanex.Nap.CMS.Infrastructure.Extensions
@model Fanex.Nap.CMS.CustomerClass.ViewModels.SiteViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.SiteManagement;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}

@section Head {
    @Styles.Render(CustomerClassBundlesConfig.SiteStyles)
}

@section Foot {
    <script type="text/javascript">
        const resources = {
            policyTitle: "@Labels.PolicyTitle",
            site: "@Labels.Site",
            currency: "@Labels.Currency",
            platform: "@Labels.Platform",
            assignSiteSettingPopupTitle: "@Labels.AssignSiteSettingPopupTitle",
            requiredField: "@Labels.RequiredField",
            uploadSiteSetting: "@Labels.UploadSiteSetting",
            notExcelFileError: "@Labels.NotExcelFileError",
            totalErrors: "@Labels.TotalErrors",
            delete: "@Labels.Delete",
            warningOverwrite: "@Labels.CCSiteOverwrite"
        };
        const siteList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Sites, jsonSettings))');
        const currencyList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Currencies, jsonSettings))');
        const platformList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Platforms, jsonSettings))');
        const sportList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.SportTypes, jsonSettings))');
    </script>
    @Scripts.Render(CustomerClassBundlesConfig.SiteScripts)
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

    <div class="filter-bar">
        @using (Html.BeginForm("Search", "Site", FormMethod.Get, new { @class = "filter-form", id = "formSearch" }))
        {
            <div class="filter-row last-row">
                <div class="lbl-field col_3">
                    <label>@Labels.SportType</label>
                </div>
                <div class="edit-field col_12">
                    @Html.DropDownList("sportType", Model.SportTypes.InsertAllItem(), new { @class = "combobox-autocomplete width-250", id = "ddlSportTypeFilter" })
                </div>
                <div class="lbl-field col_3">
                    <label>@Labels.Site</label>
                </div>
                <div class="edit-field col_8">
                    <div id="ddlSite"></div>
                </div>
            </div>
            <div class="filter-row last-row">
                <div class="lbl-field col_3">
                    <label>@Labels.PolicyTitle</label>
                </div>
                <div class="edit-field col_12">
                    @Html.DropDownList("policyTitle", Model.PolicyTitles, new { @class = "combobox-autocomplete width-250", id = "ddlPolicyTitle" })
                </div>
                <div class="lbl-field col_3">
                    <label>@Labels.Platform</label>
                </div>
                <div class="edit-field col_8">
                    <div id="ddlPlatform"></div>
                </div>
                <div class="submit width-auto">
                    <button type="submit" class="submit">@Labels.Search</button>
                    @if (Model.HasHostPermission)
                    {
                        <button type="button" class="green-button" id="btnUpload">@Labels.Upload</button>
                        <button type="button" class="submit width-140" id="btnAssignSiteSetting">@Labels.AssignSiteSetting</button>
                    }
                </div>
            </div>
        }
    </div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>

@if (Model.HasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @{
            Html.RenderPartial("~/Areas/CustomerClass/Views/Site/_AssignSiteSettingForm.cshtml", Model);
            Html.RenderPartial("~/Areas/CustomerClass/Views/Site/_UploadForm.cshtml");
        }
    </div>
}