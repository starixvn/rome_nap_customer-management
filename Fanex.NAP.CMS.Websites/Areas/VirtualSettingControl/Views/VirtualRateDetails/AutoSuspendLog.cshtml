@using Fanex.NAP.CMS.Core.Resources
@using Fanex.Nap.CMS.Infrastructure.Extensions;
@using Fanex.Nap.CMS.VirtualSettingControl.Resources;
@model string
@{
    ViewBag.Title = "Auto Suspend Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime currentDate = DateTime.Today;
}
@section Head
{
    @Styles.Render("~/bundles/virtual-rate-details/index-styles")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div class="custom-tabs">
    <span class="active">@ViewLang.Member</span>
    |
    @Html.ActionLink(ESportsResource.GlobalAutoSuspendThreshold, "GlobalAutoSuspendThresholdLog", "VirtualRateDetails", new { area = "VirtualSettingControl" }, null)
</div>
<div class="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txt-username">@ViewLang.Member</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txt-username" class="txt-username" maxlength="50" />
            </div>
            <div id="fromtodate-picker"></div>
            <div class="submit width-auto col_4">
                <input id="btn-search" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
        <div class="filter-row"></div>
    </div>
</div>
<div id="report-container" class="display-none">
    <div class="content-grid">
        <div id="virtual-rate-report-freegrid-grid-title" class="grid-title grid-title-auto-suspend-log">
            <div class="grid-title-label" id="report-tile">@ViewLang.AutoSuspendLog</div>
        </div>
        <table id="tbl-virtual-rate-report" class="tbl-auto-suspend-log">
            <thead>
                <tr>
                    <th class="col-group col-threshold" rowspan="2">
                        @ViewLang.BetType
                        <span id="ico-collapse" class="ico-collapse"></span>
                    </th>
                    <th colspan="2">@ViewLang.NonLive</th>
                    <th colspan="2">@ViewLang.Live</th>
                </tr>
                <tr>
                    <th class="col-nonlive">@ViewLang.AutoSuspend</th>
                    <th class="col-nonlive">@ViewLang.OverrideAutoSuspend</th>
                    <th class="col-live">@ViewLang.AutoSuspend</th>
                    <th class="col-live">@ViewLang.OverrideAutoSuspend</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section Foot
{
    <script type="text/javascript">
        var currentDate = '@currentDate.ToShortFormatedDateWithSlash()',
            initFromDate = '@currentDate.AddDays(-1).ToShortFormatedDateWithSlash()';
        var resources = {
            From: '@ViewLang.From',
            To: '@ViewLang.To',
            RequiredField: '@ViewLang.RequiredField',
            Message_NoReportData: '@Fanex.Nap.CMS.Infrastructure.Resources.Labels.Message_NoReportData',
            AutoSuspendLog: '@ViewLang.AutoSuspendLog',
            Update: '@ViewLang.Update',
            By: '@ViewLang.By',
            Yes: '@ViewLang.Yes',
            No: '@ViewLang.No',
            SportType: 43
        };
    </script>
    @Scripts.Render("~/bundles/virtual-rate-details/autosuspend-log")
}
