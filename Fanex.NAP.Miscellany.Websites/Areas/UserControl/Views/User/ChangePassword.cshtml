@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.Core.Web
@model UpdatePasswordCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="usertitle">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <div id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(m => m.OldUserPwd)
                </div>
                <div class="edit-field col_10">
                    @Html.PasswordFor(m => m.OldUserPwd)
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(m => m.UserPwd)
                </div>
                <div class="edit-field col_10">
                    @Html.PasswordFor(m => m.UserPwd)
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(m => m.ConfirmUserPwd)
                </div>
                <div class="edit-field col_10">
                    @Html.PasswordFor(m => m.ConfirmUserPwd)
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                </div>
                <div class="edit-field col_10">
                    <div class="submit width-auto col_3">
                        <input type="submit" value="@ViewResources.Save" />
                    </div>
                    <div class="cancel width-auto col_3">
                        <input type="button" value="Cancel" onclick="Miscellany.navigateToRoot('', 0); return false;"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Foot {
    @if (success)
    {
        <script type="text/javascript">
            $(function () {
                Miscellany.headlineMsgBox.showInfo('@ViewResources.Your_changes_were_saved!', { closeBtn: false });
            });
        </script>
    }
}