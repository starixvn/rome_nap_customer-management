@model Fanex.Nap.CMS.Customers.ViewModels.ProblemAccountLicenseeSite.IndexLicenseeSiteViewModel
@using (Html.BeginForm("UpdateInformingStatus", "ProblemAccountLicenseeSite", FormMethod.Post, new { id = "formInformingStatus", @class = "form" }))
{
    <input type="hidden" name="usernames" id="txt-usernames" value="" />
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row">
        <p>@ProblemAccountResource.SelectedAccounts: <span class="bold" id="span-selectedAccounts"></span></p>
    </div>
    <div class="form-row">
        <div class="edit-field">
            @Html.DropDownList("informedType", Model.InformTypes, new { id = "ddl-inform-type", @class = "combobox-autocomplete width-250" })
        </div>
    </div>
    <div class="form-row button-row">
        <button type="submit" class="blue-button">@ProblemAccountResource.OK</button>
        <button type="button" class="red-button" id="btn-cancel">@ProblemAccountResource.Cancel</button>
    </div>
}
