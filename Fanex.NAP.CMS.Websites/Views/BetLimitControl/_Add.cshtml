@using Fanex.Nap.CMS.Customers.Resources
@using Fanex.NAP.CMS.BetLimitControl.Models
@model IEnumerable<BetLimitTypeModel>

<div id="frmAdd" class="form expand-form">
    <div id="msgAdd" class="inline-message"></div>
    <div id="msgAddSuccess" class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field col-label full-width">
            <label for="txtUsernameAdd">@ViewLang.UsernamesSeperatedByComma<span class="required-field">*</span></label>
        </div>
        <div class="edit-field mid-margin-top mid-margin-bottom" style="width:98%">
            <textarea rows="7" id="txtUsernameAdd" class="full-width"></textarea>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field col-label">
            <label for="txtBetLimitTypeAdd">@ViewLang.BetLimitType<span class="required-field">*</span></label>
        </div>
        <div class="edit-field">
            <select id="txtBetLimitTypeAdd" class="bet-limit-type-select">
                <option value="">Please Select</option>
                @foreach (var betLimitType in @Model)
                {
                    <option value="@betLimitType.BetLimitTypeId">@betLimitType.BetLimitType</option>
                }
            </select>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field col-label">
            <label for="txtBetLimitModeAdd">@ViewLang.BetLimitMode<span class="required-field">*</span></label>
        </div>
        <div class="edit-field">
            <select id="txtBetLimitModeAdd" class="bet-limit-type-select">
                <option value="@((byte)Modes.Fixed)">@ViewLang.BetLimitFixedMode</option>
                <option value="@((byte)Modes.Percentage)">@ViewLang.BetLimitPercentageMode</option>
            </select>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field col-label">
            <label for="txtMaxPerMatchAdd">@ViewLang.MaxPerMatch<span class="required-field">*</span></label>
        </div>
        <div class="edit-field">
            <input type="text" class="input-text-right" maxlength="13" id="txtMaxPerMatchAdd" autocomplete="off" />
            <span class="percentage-tip-add">@ViewLang.BetLimitModePercentageSuffix</span>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field col-label">
            <label for="txtMaxBetAdd">@ViewLang.MaxBet<span class="required-field">*</span></label>
        </div>
        <div class="edit-field">
            <input type="text" class="input-text-right" maxlength="13" id="txtMaxBetAdd" autocomplete="off" />
            <span class="percentage-tip-add">@ViewLang.BetLimitModePercentageSuffix</span>
        </div>
    </div>
    <div class="form-row float-right button-group">
        <div class="lbl-field normal-label col-label lbl-btn-group"></div>
        <div class="edit-field">
            <input type="button" id="btnSaveAdd" class="blue-button" value="@Labels.Save" />
            <input type="button" id="btnCancelAdd" class="red-button" value="@Labels.Cancel" />
        </div>
    </div>
</div>