@using Fanex.Nap.CMS.TurnoverControl.Resources;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewLang.LossMonitor;
    var hasHostPermission = Convert.ToBoolean(ViewData["HostPermission"]);
}
@section Head
{
    @Styles.Render("~/styles/lossMonitor")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
            @if (hasHostPermission)
            {
                <button type="button" class="btnAdd" id="btnAddSetting">@Labels.Add</button>
            }
            <button type="button" class="green-button" id="btnRefresh">Refresh</button>
        </div>
    </div>
}
<div id="div-result-message" class="inline-message"></div>
<div class="content-grid">
    <div id="divSMALossMonitor" class="freegrid display-none"></div>
</div>
@if (hasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @using (Html.BeginForm("Add", "LossMonitor", FormMethod.Post, new { id = "formAddSetting", @class = "form expand-form" }))
        {
            <div id="div-result-add-message" class="inline-message"></div>
            <div class="form-row">
                <div class="lbl-field normal-label width-100">&nbsp;</div>
                <div class="lbl-field width-250">
                    <input type="radio" name="Level" checked="checked" id="rdoSMA" />
                    <label for="rdoSMA" style="margin-right: 30px;">@ViewLang.SMA</label>
                    <input type="radio" name="Level" id="rdoHeadline" />
                    <label for="rdoHeadline">@ViewLang.Headline</label>
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field normal-label width-100">
                    <label for="txt-username">@ViewLang.Username</label>
                </div>
                <div class="edit-field">
                    <input type="text" id="txt-username" class="width-230 clearable" autocomplete="off" maxlength="30"
                           data-val-required="Required field!" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field normal-label width-100">
                    <label id="lbl-maxloss" for="txt-maxloss">@ViewLang.MaxLoss</label>
                </div>
                <div class="edit-field">
                    <input type="text" id="txt-maxloss" class="width-230 clearable" autocomplete="off" maxlength="13"
                           data-val-required="Required field!"
                           data-val-number="Invalid value!" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field normal-label width-100">
                    <label id="lbl-maxloss" for="txt-maxloss">@ViewLang.LetsTalk</label>
                </div>
                <div class="edit-field">
                    <input type="checkbox" id="chk-letstalk-add" class="width-230 clearable" checked="checked" />
                </div>
            </div>
            <div class="form-row button-row">
                <div class="lbl-field normal-label width-100">&nbsp;</div>
                <div class="edit-field">
                    <button type="submit" class="blue-button" id="btnSave">@ViewLang.Add</button>
                    <button type="button" class="red-button" id="btnCancel">@ViewLang.Cancel</button>
                </div>
            </div>
        }
    </div>
}
@section Foot
{
    <script type="text/javascript">
        var rootUrl = document.getElementById("CMSRoot").value;
        var hasHostPermission = @hasHostPermission.ToString().ToLowerInvariant();
        var minIntValue = @int.MinValue;
        var labels = {
            No: "#",
            Username: "@ViewLang.Username",
            SMAName: "@ViewLang.SMAName",
            Level: "@ViewLang.Level",
            Currency: "@ViewLang.Currency",
            TotalBalance: "@ViewLang.TotalBalance",
            YesterdayBalance: "@ViewLang.YesterdayBalance",
            MaxLoss: "@ViewLang.MaxLoss",
            LossPercentage: "@ViewLang.LossPercentage",
            AutoRefresh: "@ViewLang.AutoRefresh",
            NotAvailable: "@ViewLang.NotAvailable",
            Refresh: "@Labels.Refresh",
            AddNewSetting: "@ViewLang.AddNewSetting",
            RM: "(@ViewLang.RM)",
			LetsTalk: "@ViewLang.LetsTalk",
			EnableLetsTalkAll: "@ViewLang.EnableLetsTalkAll",
			DisableLetsTalkAll: "@ViewLang.DisableLetsTalkAll"
        };
        var messages = {
            UpdateMaxLossConfirm: "Are you sure you want to update max loss of {0} to {1}?",
            MaxLossNeedNegative: "Max Loss should be negative!",
            UpdateMaxLossSuccess: "Updated Max Loss successfully.",
            AddCustomerSuccess: "Added customer {0} successfully.",
            RemoveCustomer: "Are you sure you want to remove {0}?",
            RemoveCustomerSuccess: "Removed Max Loss successfully.",
            Error_RequiredField: "Required field!",
            Error_InvalidValue: "Invalid value!",
        };
    </script>
    @Scripts.Render("~/scripts/lossMonitor")
}