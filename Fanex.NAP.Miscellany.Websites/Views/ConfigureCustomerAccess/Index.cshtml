@{
    var hasEditAccessRight = (bool)ViewBag.HasEditAccessRight;

    ViewBag.Title = ViewLang.ConfigureCustomerAccess;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/configureCustomerAccess")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@section FilterForm
{
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_3 align-right">
                    <label for="txtSearchUserName">@ViewLang.Username</label>
                </div>
                <div class="edit-field col_5 align-left">
                    <input type="text" id="txtSearchUserName" />
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
                </div>
                @if (hasEditAccessRight)
                {
                    <div class="submit width-auto col_4">
                        <input id="btnAddRequest" type="button" class="submit width-120" value="@ViewLang.AddRequest" />
                    </div>
                }
            </div>
            <div class="filter-row"></div>
        </div>
    </div>
}
<div class="display-none content-grid">
    <div id="divMemberList" class="freegrid"></div>
</div>
@if (hasEditAccessRight)
{
    <div class="display-none">
        @Html.Action("RequestForm")
    </div>
}
@section Foot
{
    @Scripts.Render("~/scripts/configureCustomerAccess")
    <script type="text/javascript">
        var labels = {
            id: '@ViewLang.ID',
            username: '@ViewLang.Username',
            expiredDate: '@ViewLang.ExpiredDate',
            country: '@ViewLang.Country',
            ip: '@ViewLang.IP',
            remark: '@ViewLang.Remark',
            createdBy: '@ViewLang.CreatedBy',
            createdDate: '@ViewLang.CreatedDate',
            lastModifiedBy: '@ViewLang.LastModifiedBy',
            lastModifiedDate: '@ViewLang.LastModifiedDate',
            edit: '@ViewLang.Edit',
            del: '@ViewLang.Delete',
            addNewRequest: '@ViewLang.AddNewRequest',
            editRequest: '@ViewLang.EditRequest',
            unlimited: '@ViewLang.Unlimited'
        };
        var messages = {
            addRequestSuccessfully: '@Messages.AddRequestSuccessfully',
            updateRequestSuccessfully: '@Messages.UpdateRequestSuccessfully',
            deleteRequestConfirm: '@Html.Raw(Messages.DeleteRequestConfirm)',
            deleteRequestSuccessfully: '@Messages.DeleteRequestSuccessfully'
        };
        var hasEditAccessRight = '@hasEditAccessRight' === 'True';
        var minDate = '@DateTime.Today.AddDays(1)';
    </script>
}