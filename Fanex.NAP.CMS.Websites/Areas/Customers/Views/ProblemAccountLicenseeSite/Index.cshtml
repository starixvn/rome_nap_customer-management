@using Newtonsoft.Json;
@using Fanex.Nap.CMS.Customers.ViewModels.ProblemAccountLicenseeSite;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ProblemAccountCreditDepositResource.ManageProblemAccountLicenseeSites;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@model IndexLicenseeSiteViewModel
@section Head
{
    @Styles.Render(CustomersBundlesConfig.ProblemAccountStyles)
}
@section Foot
{
    <script type="text/javascript">
        var resources = {
            member: "@ProblemAccountCreditDepositResource.Member",
            currency: "@ProblemAccountResource.Currency",
            maxPerMatch: "@ProblemAccountCreditDepositResource.MaxPerMatch",
            maxBet: "@ProblemAccountCreditDepositResource.MaxBet",
            preventiveAction: "@ProblemAccountCreditDepositResource.PreventiveAction",
            markDate: "@ProblemAccountResource.MarkDate",
            reason: "@ProblemAccountResource.Reason",
            comment: "@ProblemAccountResource.Comment",
            firstWeekInformed: "@ProblemAccountResource._1stWeekInformed",
            secondWeekInformed: "@ProblemAccountResource._2ndWeekInformed",
            abnormalBet: "@ProblemAccountResource.AbnormalBet",
            select: "@ProblemAccountResource.Select",
            requiredFieldError: "@ProblemAccountResource.RequiredFieldError",
            invalidValueError: "@ProblemAccountResource.InvalidValueError",
            invalidMaxBetError: "@ProblemAccountCreditDepositResource.InvalidMaxBetError",
            inputInvalidUsernamesError: "@ProblemAccountResource.InputInvalidUsernamesError",
            usernamesOutOfRangeError: "@ProblemAccountResource.UsernamesOutOfRangeError",
            duplicatedUsernamesError: "@ProblemAccountResource.DuplicatedUsernamesError",
            unmarkProblemAccount: "@ProblemAccountResource.UnmarkProblemAccount",
            reduceBLMultipleCurrenciesSelectedError: "@ProblemAccountCreditDepositResource.ReduceBLMultipleCurrenciesSelectedError",
            reduceBLNotAcknowledgedSelectedError: "@ProblemAccountCreditDepositResource.ReduceBLNotAcknowledgedSelectedError",
            pleaseSelect: "@ProblemAccountResource.PleaseSelect",
            thisFieldIsRequired: "@ProblemAccountResource.thisFieldIsRequired"
        };
        var currentDate = "@Model.CurrentDate.ToShortFormatedDateWithSlash()",
            defaultMinDate = "@Model.MinFromDate.ToShortFormatedDateWithSlash()",
            maxInputUsernames = @IndexLicenseeSiteViewModel.MaxInputUsernames,
            showSelectColumn = @Model.HasHostPermission.ToString().ToLowerInvariant(),
            autoReload = @Model.AutoReload.ToString().ToLowerInvariant();
        var reasons = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Reasons, jsonSettings))');
        var searchFilter = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.SearchFilter, jsonSettings))');
    </script>
    @Scripts.Render(CustomersBundlesConfig.ProblemAccountLicenseeSiteScript)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    @{ Html.RenderPartial("_SearchFilter", Model); }
</div>
@if (Model.HasHostPermission)
{
    <div class="button-list clear-fix">
        <div class="float-left">
            <button type="button" class="blue-button" id="btn-markNew">@ProblemAccountResource.MarkNewProblemAccount</button>
        </div>
        <div class="float-right">
            <span>@ProblemAccountResource.ActionsOnSelectedAccounts</span>
            <button type="button" class="blue-button" id="btn-updateProblemAccount">@ProblemAccountCreditDepositResource.UpdateProblemAccount</button>
            <button type="button" class="blue-button" id="btn-unmark">@ProblemAccountResource.Unmark</button>
            <button type="button" class="blue-button" id="btn-reduceBetLimit">@ProblemAccountResource.ReduceBetLimit</button>
            <button type="button" class="blue-button" id="btn-removeReducedBetLimit">@ProblemAccountResource.RemoveReducedBetLimit</button>
            <button type="button" class="blue-button" id="btn-informing-status">@ProblemAccountResource.UpdateInformingStatus</button>
        </div>
    </div>
}
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
@if (Model.HasHostPermission)
{
    <div id="divPopupContent" class="display-none">
    @{
        Html.RenderPartial("_MarkNew", Model);
        Html.RenderPartial("_UpdateProblemAccount");
        Html.RenderPartial("_Unmark");
        Html.RenderPartial("_ReduceBetLimit");
        Html.RenderPartial("_RemoveReduceBetLimit");
        Html.RenderPartial("_InformingStatus");
    }
    </div>
}