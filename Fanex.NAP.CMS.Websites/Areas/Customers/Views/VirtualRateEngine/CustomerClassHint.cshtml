@using Newtonsoft.Json;
@using Fanex.Nap.CMS.Customers.AppStart
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = VREngineResource.CustomerCategory;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Foot
{
    <script type="text/javascript">
        var customerClasses = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model, jsonSettings))');
    </script>
    @Scripts.Render(CustomersBundlesConfig.VREngineCustomerCategoryScriptPath)
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div class="content-grid" style="margin-left:25px;">
    <div class="freegrid display-none" id="freegrid"></div>
</div>