@model IEnumerable<Fanex.Nap.CMS.Infrastructure.Models.IdNameModel>
@using (Html.BeginForm("Add", "GlobalSetting", FormMethod.Post, new { id = "formAddGlobalSetting", @class = "form expand-form" }))
{
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field width-140">
            <label>@Labels.Level</label>
        </div>
        <div class="lbl-field width-230">
            <input type="radio" name="level" id="rdoSMA" checked="checked" />
            <label for="rdoSMA" class="large-margin-right">@Labels.SMA</label>
            <input type="radio" name="level" id="rdoHeadline" />
            <label for="rdoHeadline">@Labels.Headline</label>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field width-140">
            <label for="txt-addUsername">@Labels.UserName</label>
        </div>
        <div class="edit-field">
            <input type="text" id="txt-addUsername" class="width-230 clearable" autocomplete="off" maxlength="50" />
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field width-140">
            <label id="lbl-maxturnover">@Labels.Max_Turnover</label>
        </div>
    </div>
    foreach (var item in Model)
    {
        <div class="form-row">
            <div class="lbl-field width-140">
                <label for="txt-@item.Id" class="margin-left">@item.Name</label>
            </div>
            <div class="edit-field">
                <input type="text" class="width-230 clearable txt-maxturnover" autocomplete="off" maxlength="13" id="txt-@item.Id" data-profileid="@item.Id" />
            </div>
        </div>
    }
    <div class="form-row button-row">
        <div class="lbl-field width-140"></div>
        <div class="edit-field">
            <button type="submit" class="blue-button">@Labels.Add</button>
            <button type="button" class="red-button">@Labels.Cancel</button>
        </div>
    </div>
}