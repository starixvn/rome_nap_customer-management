@{
    ViewBag.Title = ViewLang.CloseOpenMember;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/openCloseMember")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <span id="spnNote" class="note-info-message" title="@Messages.CloseOpenMemberNote"></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_9 align-right">
                <label for="txtUsername">
                    <span class="level-label">@string.Format("{0} / {1} / {2} ", ViewLang.Super, ViewLang.Master, ViewLang.Agent)</span>
                    <span>@ViewLang.Username</span>
                </label>
            </div>
            <div class="edit-field col_7 align-left">
                <input type="text" id="txtUsername" class="width-180" data-val-required="@Messages.RequiredFieldError"/>
            </div>
            <div class="lbl-field col_5 align-right">
                <label for="ddlStatus">@ViewLang.MembersStatus</label>
            </div>
            <div class="edit-field col_5 align-left">
                <select id="ddlStatus" class="combobox-autocomplete level-combobox">
                    <option value="-1">@ViewLang.All</option>
                    <option value="0">@ViewLang.Open</option>
                    <option value="1">@ViewLang.Closed</option>
                </select>
            </div>
            <div class="submit width-auto col_3">
                <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
        <div class="filter-row"></div>
    </div>
</div>
<div class="display-none content-grid">
    <div id="divMemberList" class="freegrid"></div>
</div>
<div id="divButtons" class="button-div display-none">
    <input id="btnOpen" type="button" class="green-button" data-value="@ViewLang.OpenSelectedAccounts" />
    <input id="btnClose" type="button" class="red-button" data-value="@ViewLang.CloseSelectedAccounts" />
</div>
@section Foot
{
    @Scripts.Render("~/scripts/openCloseMember")
    <script type="text/javascript">
        var labels = {
            order: '#',
            master: '@ViewLang.Master',
            agent: '@ViewLang.Agent',
            member: '@ViewLang.Member',
            status: '@ViewLang.Status',
            closed: '@ViewLang.Closed',
            open: '@ViewLang.Open'
        };
        var messages = {
            requiredStatusCol: '@Html.Raw(Messages.RequiredStatusColumnError)',
            updateStatusSuccessfully: '@Messages.UpdateMemberStatusSuccessfully',
            updateStatusFailed: '@Messages.UpdateMemberStatusFailed',
            openMemberConfirmationMsg: '@Messages.OpenMemberConfirmationMessage',
            closeMemberConfirmationMsg: '@Messages.CloseMemberConfirmationMessage'
        };
    </script>
}