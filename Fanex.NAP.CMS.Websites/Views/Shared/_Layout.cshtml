@{
    var showMenus = ViewBag.ShowMenus != null ? (bool)ViewBag.ShowMenus : true;
}
<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewLang.CMS &mdash; @ViewBag.Title</title>
    <link rel="shortcut icon" href="~/content/Themes/img/CMS.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <!--[if lt IE 9]><script src="~/Scripts/Libs/html5-libs/html5shiv.min.js" type="text/javascript"></script><![endif]-->
    @Styles.Render("~/styles/common")
    @RenderSection("Head", false)
</head>
<body>
    @if (showMenus)
    {
        <header>
            <div class="logo">
                <a href="~/?ref=logo"></a>
            </div>
            @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
            <div class="user-info">
                <div class="greeting">
                    <h2>Welcome <span class="info-acc">@HttpContext.Current.User.Identity.Name</span><span class="info-more"></span></h2>
                    <ul>
                        <li>@Html.ActionLink(ViewResources.Profile, "UserProfile", "UserInfo")</li>
                        <li>@Html.ActionLink(ViewResources.Change_Password, "ChangePassword", "UserInfo")</li>
                        <li>@Html.ActionLink(ViewResources.Sign_Out, "LogOut", "Login")</li>
                    </ul>
                </div>
            </div>
        </header>
    }
    <section id="headline">
        @if (showMenus)
        {
            <span class="server-time">@string.Format("{0} {1}", ViewBag.ServerDate, ViewLang.GMTMinus4)</span>
        }
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        <div class="content">
            @RenderBody()
        </div>
    </section>
    <div id="dialog-popup"></div>
    @Html.Hidden("CMSRoot", Url.Content("~/"))
    @Html.Hidden("AccessDeniedError", Messages.AccessDenied)
    @Html.Hidden("NotFoundError", Messages.NotFoundMessage)
    @Html.Hidden("InternalError", Messages.InternalError)
    @Html.Hidden("ShowMenus", showMenus)
    @Scripts.Render("~/scripts/common")
    @if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
    {
        <script src="~/Scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @RenderSection("Foot", false)
</body>
</html>