@using Newtonsoft.Json;
@using Fanex.Nap.CMS.Customers.ViewModels.PossessStatistics
@model IndexViewModel
@{
    ViewBag.Title = PossessStatisticsResource.PossessStatistics;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Head{
    @Styles.Render(CustomersBundlesConfig.PossessStatisticsStyles)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    @Html.Partial("_Filter", Model.FilterViewModel)
</div>
@if (Model.HasUpdateDangerLevelPermission || Model.HasUpdateMonitorStatusPermission)
{
    <div class="button-list clear-fix">
        <div class="float-right">
            @if (Model.HasUpdateDangerLevelPermission)
            {
                <button type="button" class="blue-button" id="btnUpdateDangerLevel">@PossessStatisticsResource.UpdateDangerLevel</button>
            }

            @if (Model.HasUpdateMonitorStatusPermission)
            {
                <button type="button" class="blue-button" id="btnUpdateMonitorStatus">@PossessStatisticsResource.UpdateMonitorStatus</button>
            }
        </div>
    </div>
}
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
@if (Model.HasUpdateDangerLevelPermission || Model.HasUpdateMonitorStatusPermission)
{
    <div id="divPopupContent" class="display-none">
        @if (Model.HasUpdateDangerLevelPermission)
        {
            @Html.Partial("_UpdateDangerLevel", new UpdateDangerLevelViewModel())
        }
        @if (Model.HasUpdateMonitorStatusPermission)
        {
            @Html.Partial("_UpdateMonitorStatus", new UpdateMonitorStatusViewModel())
        }
    </div>
}
@section Foot
{
    <script type="text/javascript">
        var resources = {
            Numero: "@PossessStatisticsResource.numero",
            TotalPercent: "@PossessStatisticsResource.TotalPercent",
            Super: "@PossessStatisticsResource.Super",
            Master: "@PossessStatisticsResource.Master",
            Agent: "@PossessStatisticsResource.Agent",
            Sportsbook: "@PossessStatisticsResource.Sportsbook",
            NonSport: "@PossessStatisticsResource.NonSport",
            Username: "@PossessStatisticsResource.Username",
            Status: "@PossessStatisticsResource.Status",
            ABIDangerLevel: "@PossessStatisticsResource.ABIDangerLevel",
            Monitored: "@PossessStatisticsResource.Monitored",
            ThisPage: "@PossessStatisticsResource.ThisPage",
            UpdateDangerLevel: "@PossessStatisticsResource.UpdateDangerLevel",
            UpdateMonitorStatus: "@PossessStatisticsResource.UpdateMonitorStatus",
            requiredFieldError: "@ProblemAccountResource.RequiredFieldError",
        };

        var agentStatus = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.FilterViewModel.AccountStatus, jsonSettings))');
    </script>
    @Scripts.Render(CustomersBundlesConfig.PossessStatisticsScript)
}
