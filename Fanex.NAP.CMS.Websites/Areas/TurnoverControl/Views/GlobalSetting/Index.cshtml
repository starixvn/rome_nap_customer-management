@using Fanex.Nap.CMS.TurnoverControl.AppStart;
@using Fanex.Nap.CMS.TurnoverControl.Enums;
@using Fanex.Nap.CMS.TurnoverControl.Resources;
@{
    short sportType = Convert.ToInt16(ViewData["SportType"]);
    bool hasHostPermission = Convert.ToBoolean(ViewData["HostPermission"]);

    ViewBag.Title = sportType == (short)SportType.Others ?
        Labels.Global_Setting_OtherSports :
        Labels.Global_Setting;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render(TurnoverControlBundleConfig.GlobalSettingStyles)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    @using (Html.BeginForm("GetList", "GlobalSetting", FormMethod.Get, new { id = "formGlobalSetting", @class = "filter-form" }))
    {
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txt-username">@Labels.UserName</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txt-username" class="width-180" autocomplete="off" maxlength="30" />
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.Currency</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-currency" class="combobox-autocomplete ddl-currency width-100"></select>
            </div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit">@Labels.Search</button>
            </div>
            @if (hasHostPermission)
            {
                <div class="submit width-auto col_3">
                    <button type="button" id="btn-add" class="submit">@Labels.Add</button>
                </div>
            }
        </div>
        <div class="filter-row"></div>
    }
</div>
<div id="div-result-message" class="inline-message"></div>
<div id="globalsetting-list-container" class="content-grid">
    <div id="globalsetting-list" class="freegrid display-none">
    </div>
</div>
@if (hasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @{ Html.RenderPartial("_AddGlobalSetting"); }
    </div>
}
@section Foot
{
    <script type="text/javascript">
        var rootUrl = document.getElementById("CMSRoot").value;
        var hasHostPermission = @hasHostPermission.ToString().ToLowerInvariant();
        var sportType = @sportType;
        var maxIntValue = @int.MaxValue;
        var viewResources = {
            Symbol_No: '@Labels.Symbol_No',
            UserName: '@Labels.UserName',
            Level: '@Labels.Level',
            Currency: '@Labels.Currency',
            Max_Turnover: '@Labels.Max_Turnover',
            Delete: '@Labels.Delete',
            GlobalSetting_EditMaxTurnover_Confirm: '@Labels.GlobalSetting_EditMaxTurnover_Confirm',
            GlobalSetting_MaxTurnover_ExceedMaxTurnover: '@Labels.GlobalSetting_MaxTurnover_ExceedMaxTurnover',
            GlobalSetting_DeleteMaxTurnover_Confirm:'@Labels.GlobalSetting_DeleteMaxTurnover_Confirm',
            GlobalSetting_AddNewSMA_Title: '@Labels.GlobalSetting_AddNewSMA_Title',
            Error_RequiredField: '@Labels.Error_RequiredField',
            Error_InvalidValue: '@Fanex.NAP.CMS.Core.Resources.Messages.InvalidValueError',
            RM: '@Labels.RM'
        };
    </script>
    @Scripts.Render(TurnoverControlBundleConfig.GlobalSettingScripts)
}
