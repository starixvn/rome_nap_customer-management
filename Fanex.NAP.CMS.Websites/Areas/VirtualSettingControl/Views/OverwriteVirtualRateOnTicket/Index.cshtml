@using Fanex.Nap.CMS.VirtualSettingControl
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Overwrite Virtual Rate on Ticket";
}
@section Head
{
    @Styles.Render(VirtualSettingControlBundleConfig.OverwriteVirtualRateOnTicketStyle)
}
@section Foot
{
    <script type="text/javascript">
    </script>
    @Scripts.Render(VirtualSettingControlBundleConfig.OverwriteVirtualRateOnTicketScript)
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<button class="blue-button" id="btnAddNewRule">Add New Rule</button>
<div class="table-container mid-margin-top">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Priority</th>
                <th>Criteria</th>
                <th>Adjustment</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="4">Low stake for soccer, credit, phone betting: 0%</td>
            </tr>
            <tr>
                <td>1000</td>
                <td>
                    <div>- Sport: in (Soccer)</div>
                    <div>- Site Type: Credit</div>
                    <div>- Site: not in (CN88)</div>
                    <div>- Stake (RM): from 0 to 80</div>
                    <div>- Bet from: p (Phone betting)</div>
                </td>
                <td>0%</td>
                <td class="align-center">
                    <span class="ico-edit"></span>
                    <span class="ico-delete"></span>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div id="divPopupContent" class="display-none">
    @using (Html.BeginForm("AddNewRule", "OverwriteVirtualRateOnTicket", FormMethod.Post, new { @class = "form", id = "form-addNewRule" }))
    {
        <div class="form-row">
            <div class="lbl-field">
                <label for="txt-ruleTitle">Rule Title</label>
            </div>
            <div class="edit-field">
                <input type="text" class="rule-title" id="txt-ruleTitle" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="txt-priority">Priority</label>
            </div>
            <div class="edit-field">
                <input type="text" class="width-60" id="txt-priority" />
                <span class="priority-note">Range: [1; 10,000] the higher value, the higher priority.</span>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label>Criteria</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label class="lbl-field-criteria"><span class="lbl-field-criteria-no">[1].</span>Site Type</label>
            </div>
            <div class="edit-field">
                <div class="enable-criteria-container">
                    <input type="checkbox"/>
                    <span class="note-info-message"></span>
                </div>
                <select class="combobox-autocomplete width-250" id="ddl-siteType">
                    <option value="0" selected="selected">All</option>
                    <option value="1">Credit</option>
                    <option value="2">Licensee</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label class="lbl-field-criteria2">Site</label>
            </div>
            <div class="edit-field">
                <div class="enable-criteria-container"></div>
                <select class="combobox-autocomplete width-60" id="ddl-siteSelection">
                    <option value="0" selected="selected">in</option>
                    <option value="1">not in</option>
                </select>
                <div id="ddl-site"></div>
            </div>
        </div>
        <div class="form-row button-row">
            <button type="submit" class="blue-button">Submit</button>
            <button type="button" class="red-button" id="btn-cancel">Cancel</button>
        </div>
    }
</div>
