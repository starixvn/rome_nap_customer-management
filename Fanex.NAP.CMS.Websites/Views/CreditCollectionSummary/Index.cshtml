@using Fanex.Nap.CMS.Infrastructure.Extensions;
@using Fanex.NAP.CMS.Models.CreditCollectionSummary;
@using Fanex.NAP.CMS.ViewModels.CreditCollectionSummary;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewLang.CreditCollectionSummary;
}
@section Head
{
    @Styles.Render("~/styles/credit-collection-summary")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="div-result-message" class="inline-message"></div>
<div class="filter-bar">
    <span id="note-info" class="note-info-message" title="@Messages.CreditCollectionNote"></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_5">
                <label for="txt-username">@ViewLang.Code</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txt-username" />
            </div>
            <div class="lbl-field col_6 align-right">
                <label for="ddl-code">@ViewLang.Type</label>
            </div>
            <div class="edit-field col_6 align-left">
                <select id="ddl-code" class="combobox-autocomplete ddl-code">
                    <option value="@CodeType.All">@ViewLang.All</option>
                    <option value="@CodeType.OldCodes">@ViewLang.OLDcodes</option>
                    <option value="@CodeType.OtherCodes">@ViewLang.Othercodes</option>
                </select>
            </div>
            <div class="lbl-field col_5 align-right">
                <label for="ddl-status">@ViewLang.Status</label>
            </div>
            <div class="edit-field col_8 align-left">
                <select id="ddl-status" class="ddl-status">
                    <option value="@CreditStatus.All">@ViewLang.All</option>
                    <option value="@CreditStatus.Alert">@ViewLang.Alert</option>
                    <option value="@CreditStatus.Normal">@ViewLang.Normal</option>
                    <option value="@CreditStatus.Unused">@ViewLang.Unused</option>
                </select>
            </div>
        </div>

        <div class="filter-row">
            <div class="lbl-field col_5 align-right">
                <label for="ddl-mode">@ViewLang.Mode</label>
            </div>
            <div class="edit-field col_7 align-left">
                <select id="ddl-mode" class="combobox-autocomplete ddl-mode">
                    <option value="1">@ViewLang.Monthly</option>
                    <option value="2">@ViewLang.Weekly</option>
                </select>
            </div>
            <div class="ui_nexdatepicker_lbl_field col_6 lbl-field">@ViewLang.LastBalanceDate</div>
            <div class="ui_nexdatepicker_edit_field edit-field col_6">
                <input id="dpk-fromdate-monthly" name="dpk-fromdate-monthly" type="text" readonly="readonly" class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate" value="@CreditCollectionSummaryViewModel.InitFromDateMonthlyMode">
                <input id="dpk-fromdate-weekly" name="dpk-fromdate-weekly" type="text" readonly="readonly" class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate display-none" value="@CreditCollectionSummaryViewModel.InitFromDateWeeklyMode">
            </div>
            <div class="ui_nexdatepicker_lbl_field col_5 lbl-field">@ViewLang.CurrentBalanceDate</div>
            <div class="ui_nexdatepicker_edit_field edit-field col_6">
                <input id="dpk-todate-monthly" name="dpk-todate-monthly" type="text" readonly="readonly" class="ui_nexdatepicker_datetextbox ui_nexdatepicker_todate" value="@CreditCollectionSummaryViewModel.InitToDateMonthlyMode">
                <input id="dpk-todate-weekly" name="dpk-todate-weekly" type="text" readonly="readonly" class="ui_nexdatepicker_datetextbox ui_nexdatepicker_todate display-none" value="@CreditCollectionSummaryViewModel.InitToDateWeeklyMode">
            </div>
        </div>

        <div class="filter-row">
            <div class="lbl-field col_5 align-right"></div>
            <div class="submit width-auto col_4">
                <input id="btn-generate" type="button" class="submit" value="@ViewLang.Generate" />
                <input id="btn-export" type="button" class="submit" value="@ViewLang.Export" />
            </div>
        </div>
    </div>
</div>
<div class="content-grid">
    <div id="div-report" class="freegrid display-none"></div>
</div>

@section Foot
{
    <script type="text/javascript">
        var currentDate = '@DateTime.Today.ToString("MMM dd, yyyy")';
        var yesterday = '@DateTime.Today.AddDays(-1).ToString("MMM dd, yyyy")';
        var initFromDate = currentDate;
        var hasEditAccessRight = @(ViewBag.HasEditAccessRight ? 1 : 0);

        var minMonthly = '@Fanex.Nap.CMS.Infrastructure.Extensions.DateTimeExtensions.FirstDayOfMonth(DateTime.Today.AddMonths(-12)).ToString("MMM dd, yyyy")';
        var maxMonthly = '@Fanex.Nap.CMS.Infrastructure.Extensions.DateTimeExtensions.LastDayOfMonth(DateTime.Today).ToString("MMM dd, yyyy")';
        var minFromDateWeekly = '@CreditCollectionSummaryViewModel.MinFromDateWeekly';
        var maxFromDateWeekly = '@CreditCollectionSummaryViewModel.MaxFromDateWeekly';
        var minToDateWeekly = '@CreditCollectionSummaryViewModel.MinToDateWeekly';
        var maxToDateWeekly = '@CreditCollectionSummaryViewModel.MaxToDateWeekly';


        var viewResources = {
            LastBalanceDate: "@ViewLang.LastBalanceDate",
            CurrentBalanceDate: "@ViewLang.CurrentBalanceDate",
            RequiredFieldError: "@Messages.RequiredFieldError",

            No: "@ViewLang.No",
            All: "@ViewLang.All",
            Code: "@ViewLang.Code",
            Headline: "@ViewLang.Headline",
            Direct: "@ViewLang.Direct",
            Status: "@ViewLang.Status",
            Edit: "@ViewLang.Edit",
            LastBalance: "@ViewLang.LastBalance",
            CurrentBalance: "@ViewLang.CurrentBalance",
            DebtMovement: "@ViewLang.DebtMovement",
            Collection: "@ViewLang.Collection",
            Payment: "@ViewLang.Payment",
            NetMovement: "@ViewLang.NetMovement",
            CollectionBreakdown: "@ViewLang.CollectionBreakdown",
            To: "@ViewLang.To",
            Alert: "@ViewLang.Alert",
            Normal: "@ViewLang.Normal",
            Unused: "@ViewLang.Unused",
            Save: "@ViewLang.Save",
            Revert: "@ViewLang.Revert",
            CreditCollectionSummary:"@ViewLang.CreditCollectionSummary",
            CreditCollection_MonthlyRangeError:"@ViewLang.CreditCollection_MonthlyRangeError",
            CreditCollection_WeeklyRangeError:"@ViewLang.CreditCollection_WeeklyRangeError"
        }
    </script>
    @Scripts.Render("~/scripts/credit-collection-summary")
}