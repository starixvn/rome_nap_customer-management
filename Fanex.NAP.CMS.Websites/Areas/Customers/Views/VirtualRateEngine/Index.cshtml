@using Newtonsoft.Json;
@using Fanex.Nap.CMS.Customers.AppStart
@using Fanex.Nap.CMS.Customers.ViewModels.VirtualRateEngine;
@model VirtualRateEngineIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Virtual Rate Engine";
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Head
{
    @Styles.Render(CustomersBundlesConfig.VirtualRateEngineStylePath)
}
@section Foot
{
    <script type="text/javascript">
        var resources = {
            requiredFieldError: "@Labels.RequiredFieldError",
            invalidValueError: "@Labels.InvalidValueError"
        };
        var vm = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model, jsonSettings))');
    </script>
    @Scripts.Render(CustomersBundlesConfig.VirtualRateEngineScriptPath)
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<button class="blue-button" id="btnAddNewRule">Add New Rule</button>
<div class="table-container mid-margin-top">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Priority</th>
                <th>Criteria</th>
                <th>Adjustment</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="4">Low stake for soccer, credit, phone betting: 0%</td>
            </tr>
            <tr>
                <td>1000</td>
                <td>
                    <div>- Sport: in (Soccer)</div>
                    <div>- Site Type: Credit</div>
                    <div>- Site: not in (CN88)</div>
                    <div>- Stake (RM): from 0 to 80</div>
                    <div>- Bet from: p (Phone betting)</div>
                </td>
                <td>0%</td>
                <td class="align-center">
                    <span class="ico-edit"></span>
                    <span class="ico-delete"></span>
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div id="divPopupContent" class="display-none">
    @using (Html.BeginForm("AddNewRule", "VirtualRateEngine", FormMethod.Post, new { @class = "form", id = "form-addNewRule" }))
    {
        <div class="form-row">
            <div class="lbl-field">
                <label for="txt-ruleTitle">Rule Title</label>
            </div>
            <div class="edit-field">
                <input type="text" class="rule-title" id="txt-ruleTitle" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="txt-priorityOrder">Priority Order</label>
                <span class="text-red">*</span>
            </div>
            <div class="edit-field">
                <input type="text" class="width-60" id="txt-priorityOrder" />
                <span class="priority-note">Range: [1;10,000] the lower value, the higher priority.</span>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label>Criteria</label>
            </div>
        </div>
        <div id="div-criteriaContainer"></div>
        <div class="form-row adjustment-row">
            <span class="lbl-field">Adjustment</span>
            <div class="edit-field">
                <select class="combobox-autocomplete width-180" id="ddl-adjustment"></select>
                <div class="active-value">
                    <input type="text" class="width-60" id="txt-adjustment" autocomplete="off" maxlength="4" />
                    <span>%</span>
                </div>
            </div>
        </div>
        <div class="form-row">
            <span class="lbl-field">Active</span>
            <div class="edit-field">
                <select class="combobox-autocomplete width-180" id="ddl-active"></select>
            </div>
        </div>
        <div class="button-row">
            <button type="submit" class="blue-button" id="btn-addNew">Submit</button>
            <button type="button" class="red-button" id="btn-cancel">Cancel</button>
        </div>
    }
</div>
