    <title>@ViewBag.Title</title>
    @Styles.Render("~/styles/common")
    @Styles.Render("~/areas/turnovercontrol/turnovermonitor/companyturnoverstyles")
</head>
<body>
    <div class="form expand-form">
        <div id="div-result-message" class="inline-message">
        </div>
        <div class="form-row">
            <div id="turnover-balance-container" class="content-grid">
                <div id="turnover-balance" class="freegrid display-none">
                </div>
