@using Fanex.Nap.CMS.Infrastructure.Extensions;
@using Fanex.Nap.CMS.Admin.ViewModels.ConcurrentUser;
@using Fanex.Nap.CMS.Admin.Resources;
@using Fanex.Nap.CMS.Infrastructure.Resources;

@model ConcurrentUserHistoryViewModel
@{
    ViewBag.Title = AdminResource.ConcurrentUsersTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/bundles/concurrent-user/index")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
        <div><span class="popup" id="noteMessage"></span></div>
    </div>
}
<div class="custom-tabs">
    @Html.ActionLink(AdminResource.InstantData, "index", "ConcurrentUser")
    |
    <span class="active">@AdminResource.HistoricalData</span> |
    @Html.ActionLink(AdminResource.DailyReport, "HistoryByDaily", "ConcurrentUser")
</div>

<div class="filter-bar">
    @using (Html.BeginForm("GetHistory", "ConcurrentUser", FormMethod.Get, new { id = "formSearch", @class = "filter-form" }))
    {
        <div class="filter-row">
            <div id="fromtodate-picker"></div>

            <div class="submit width-auto col_8">
                <button type="submit" class="submit btn-search">Search</button>
            </div>
        </div>
        <div class="filter-row"></div>
    }
</div>

<div class="content-grid">
    <div id="div-result-message" class="no-data-message display-none">@Labels.Message_NoReportData</div>
    <div class="freegrid display-none" id="summaryFreegrid"></div>

    <div class="freegrid display-none detailGrid" id="detailFreegrid"></div>
</div>
<div id="divPopupContent" class="display-none">
    @Html.Action("RequestForm")
</div>

@section Foot
{
    <script type="text/javascript">
        var resources = {
            defaultFromDate: "@Model.FromDate.ToShortFormatedDateWithSlash()",
            defaultToDate: "@Model.ToDate.ToShortFormatedDateWithSlash()",
            maxDate: "@Model.MaxDate.ToShortFormatedDateWithSlash()",
            minDate: "@Model.MinDate.ToShortFormatedDateWithSlash()"
        };
    </script>
    @Scripts.Render("~/scripts/concurrent-user/history")

}
