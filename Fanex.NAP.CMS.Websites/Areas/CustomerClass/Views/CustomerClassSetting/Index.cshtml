@using Newtonsoft.Json
@using Fanex.Nap.CMS.Infrastructure.Extensions
@model Fanex.Nap.CMS.CustomerClass.ViewModels.CustomerClassSettingViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.CustomerClassSetting;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
    const int BasketBallSportType = 2;
}

@section Head {
    @Styles.Render(CustomerClassBundlesConfig.CustomerClassSettingStyles)
}

@section Foot {
    <script type="text/javascript">
        const resources = {
            ruleTitle: "@Labels.RuleTitle",
            customerClass: "@Labels.CustomerClass",
            generalCC: "@Labels.GeneralCC",
            sportCC: "@Labels.SportCC",
            site: "@Labels.Site",
            currency: "@Labels.Currency",
            platform: "@Labels.Platform",
            sportType: "@Labels.SportType",
            leagueGroup: "@Labels.LeagueGroup",
            isLive: "@Labels.IsLive",
            diffBalanceRatio: "@Labels.DiffBalanceRatio",
            betDelay: "@Labels.BetDelay",
            nextSuperSiteBetIntervalSec: "@Labels.NextSuperSiteBetIntervalSec",
            minMaxBetMPM: "@Labels.MinMaxBetMPM",
            repeatedBets: "@Labels.RepeatedBets",
            seizeBet: "@Labels.SeizeBet",
            disableParlay: "@Labels.DisableParlay",
            peakHourSpread: "@Labels.PeakHourSpread",
            enable: "@Labels.Enable",
            topPriority: "@Labels.TopPriority",
            all: "@Labels.All",
            yes: "@Labels.Yes",
            no: "@Labels.No"
        };
        const leagueGroupList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.LeagueGroups, jsonSettings))');
        const siteList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Sites, jsonSettings))');
        const sportList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.SportTypes, jsonSettings))');
        const currencyList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Currencies, jsonSettings))');
    </script>
    @Scripts.Render(CustomerClassBundlesConfig.CustomerClassSettingScripts)
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="filter-bar">
    @using (Html.BeginForm("Search", "CustomerClassSetting", FormMethod.Get, new { @class = "filter-form", id = "formSearch" }))
    {
    <div class="filter-row first-row">
        <div class="lbl-field col_2">
            <label>@Labels.Site</label>
        </div>
        <div class="edit-field col_7">
            <div id="ddlSites"></div>
        </div>
        <div class="lbl-field col_3">
            <label>@Labels.SportType</label>
        </div>
        <div class="edit-field col_5">
            @Html.DropDownList("sportType", Model.SportTypes.InsertAllItem(), new { @class = "combobox-autocomplete width-80", id = "ddlSportType" })
        </div>
        <div class="lbl-field col_3">
            <label>@Labels.GeneralCC</label>
        </div>
        <div class="edit-field col_4">
            <input type="text" id="txtCCSFilterCustomerClass" class="filter-cc" />
        </div>
        <div class="lbl-field col_4">
            <label>@Labels.SportCC</label>
        </div>
        <div class="edit-field col_4">
            <input type="text" id="txtCCSFilterCustomerClassDetail" class="filter-cc" />
        </div>
        <div class="lbl-field col_4">
            <label>@Labels.Currency</label>
        </div>
        <div class="edit-field col_5">
            <div id="ddlCurrencies"></div>
        </div>
        <div class="submit width-auto">
            <button type="submit" class="submit">@Labels.Search</button>
        </div>
    </div>
        @*<div class="filter-row ">
            <div class="note-info-message-box">
                <span class="note-info-message"></span>
                <span id="note-info-message">For better performance, please select option "All" on only 1 filter condition.</span>
            </div>
        </div>*@
    }
</div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
