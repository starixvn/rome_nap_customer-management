@model Fanex.Nap.CMS.ManageChatbots.Models.ChatbotMapping.ChatBotsConfigModel
@using (Html.BeginForm("UpdateChatBotConfig", "ChatBotMapping", FormMethod.Post, new { id = "formChatBotConfig", @class = "form expand-form" }))
{
    <div id="config-chat-bot-popup">
        <div id="div-inlineMessage" class="inline-message"></div>
        <div class="container">
            <div class="col">
                <div>Bot SerVice:</div>
                <div>Username:</div>
                <div>Chatbot Name:</div>
            </div>
            <div class="col">
                <div id="BotSerVice">
                    <b>Telegram</b>
                </div>
                <div id="Username">
                    <b>@Model.ChatBotModel.UserName</b>
                </div>
                <div id="ChatBotName">
                    <b>@Model.ChatBotModel.ChatBotName</b>
                </div>
            </div>
            <div class="col">
                <div>Msg. Username:</div>
                <div>Sub Account:</div>
                <div>Status</div>
            </div>
            <div class="col">
                <div id="MsgUsername">
                    <b>@Model.ChatBotModel.ChatID</b>
                </div>
                <div id="SubAccount">
                    @if (@Model.ChatBotModel.SubAccount == "")
                    {
                        <br/>
                    }
                    else
                    {
                        <b>@Model.ChatBotModel.SubAccount</b>
                    }
                </div>
                <div>

                    @if (@Model.ChatBotModel.IsVerifyOTP && @Model.ChatBotModel.Status)
                    {
                        <span class="high-light green">Linked</span>
                        <button type="button" class="red-button" id="btn-cancel">Unlink</button>
                    }
                    else
                    {
                        <span class="high-light yellow">Verifying</span>
                    }
                </div>
            </div>


        </div>
        <hr/>
        <div class="container">
            <div class="col">
                <div>Language:</div>
            </div>
            <div class="col">
                <select id="ddl-Language" class="combobox-autocomplete width-200"></select>
            </div>
        </div>


        <div>
            <table>
                <tr>
                    <th>Functions/Notifications</th>
                    <th class="align-center">Enable</th>
                </tr>
                @foreach (var functionConfig in @Model.FunctionConfigs)
                {
                    <tr>
                        <td>@functionConfig.FunctionName</td>
                        @if (@functionConfig.IsEnabled)
                        {
                            <td>
                                <div class="float-center">
                                    <div class="toggle-on-off status-on" funct-id=@functionConfig.FunctionId> </div>
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>
                                <div class="float-center">
                                    <div class="toggle-on-off status-off" funct-id=@functionConfig.FunctionId> </div>
                                </div>
                            </td>
                        }
                    </tr>
                }

            </table>
            <div class="popup-footer">
                <button type="submit" class="blue-button submit">Save</button>
                <button type="button" class="red-button">Close</button>
            </div>

        </div>
    </div>
}