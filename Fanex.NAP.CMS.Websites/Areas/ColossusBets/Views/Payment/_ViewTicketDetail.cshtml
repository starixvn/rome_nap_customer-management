<div id="ticketDetailContainer">
    <div class="form expand-form float-left ticketColossusBets">
        <div class="form-row">
            <p>Ticket detail of 1234567890.</p>
            <p>Milionaire - Pick 6 MAY 13 15.00.</p>
        </div>
        <div class="form-row">
            <p>Manchester City vs West Ham United.</p>
            <p>1-0 | 2-0</p>
        </div>
        <div class="form-row">
            <p>Norwich vs Asernal.</p>
            <p>A0A</p>
        </div>
        <div class="form-row">
            <p>Leyton Orient vs Peterborough.</p>
            <p>2-1</p>
        </div>
    </div>
    <div class="form expand-form float-right">
        <div class="form-row">
            <p id="ticketDetailOwn"></p>
            <p id="ticketDetailSold"></p>
        </div>
        <div class="form-row">
            <table class="tblColossusBets">
                <thead>
                    <tr>
                        <th>@ColossusBetsLabels.Date</th>
                        <th>@ColossusBetsLabels.TransactionType</th>
                        <th>@ColossusBetsLabels.WinLoss</th>
                        <th>@ColossusBetsLabels.Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="form-row button-row">
            <button type="button" class="red-button">@ColossusBetsLabels.Close</button>
        </div>
    </div>
</div>