@using Newtonsoft.Json;
@using Fanex.Nap.CMS.Customers.AppStart
@using Fanex.Nap.CMS.Customers.ViewModels.VirtualRateEngine;
@model VREngineIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = VREngineResource.VirtualRateEngine;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Head
{
    @Styles.Render(CustomersBundlesConfig.VirtualRateEngineStylePath)
}
@section Foot
{
    <script type="text/javascript">
        var resources = {
            requiredFieldError: "@Labels.ThisFieldIsRequired",
            invalidValueError: "@Labels.InvalidValueError",
            priorityOrderValueOutOfRangeError: "@VREngineResource.PriorityOrderValueOutOfRangeError",
            vrValueOutOfRangeError: "@VREngineResource.VirtualRateValueOutOfRangeError",
            VRFromGreaterThanVRToError: "@VREngineResource.VRFromGreaterThanVRToError",
            noneSelectedOptionError: "@VREngineResource.NoneSelectedOptionError",
            invalidTimeFormat: "@VREngineResource.InvalidTimeFormat",
            fromStakeGreaterThanToStake: "@VREngineResource.FromStakeGreaterThanToStake",
            fromTimeGreaterThanToTime: "@VREngineResource.FromTimeGreaterThanToTime"
        };
        var vm = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model, jsonSettings))');
        var hasHostFullPermission = @(Model.HasHostFullPermission ? 1 : 0);
        var hasHostVirtualRateEnginePermission = @(Model.HasHostVirtualRateEnginePermission ? 1 : 0);
    </script>
    @Scripts.Render(CustomersBundlesConfig.VirtualRateEngineScriptPath)
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
@if (Model.HasHostFullPermission)
{
    <button class="blue-button" id="btnAddNewRule">@VREngineResource.AddNewRule</button>
}
<div class="content-grid mid-margin-top">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
@if (Model.HasHostFullPermission)
{
    <div id="divPopupContent" class="display-none">
        @{ Html.RenderPartial("~/Areas/Customers/Views/VirtualRateEngine/_AddNewRule.cshtml"); }
    </div>
}
