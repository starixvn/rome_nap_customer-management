@{
    var hasEditAccessRight = (bool)ViewBag.HasEditAccessRight;

    ViewBag.Title = ViewLang.ManageSmartPunters;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/manageSmartPunters")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div class="tabs-area">
        <div id="divFilterFormTag" class="tab first active">@ViewLang.ManageSmartPunters</div>
        <div id="divLogFormTag" class="tab">Smart Punter Control Log</div>
        <span id="spnNote" class="note-info-message" title="@Messages.ManageSmartPunterNote"></span>
    </div>
    <div id="divFilterForm" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_5">
                <label for="txtUsername">@ViewLang.Username/@ViewLang.Nickname</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txtUsername" class="width-170" maxlength="30" />
            </div>
            <div class="lbl-field col_2">
                <label for="ddlStatus">@ViewLang.Status</label>
            </div>
            <div class="edit-field col_5">
                <select id="ddlStatus" class="combobox-autocomplete status-combobox">
                    <option value="0">@ViewLang.All</option>
                    <option value="1">@ViewLang.Open</option>
                    <option value="2">@ViewLang.Suspended</option>
                    <option value="3">@ViewLang.Closed</option>
                </select>
            </div>
            <div class="submit width-auto col_3">
                <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
            @if (hasEditAccessRight)
            {
                <div class="submit width-auto col_4">
                    <input id="btnAddSmartPunter" type="button" class="submit width-140" value="@ViewLang.AddSmartPunter" />
                </div>
            }
        </div>
        <div class="filter-row"></div>
    </div>
    <div id="divLogForm" class="filter-form display-none">
        <div class="filter-row">
            <div id="divDatepickerPlugin"></div>
            <div class="lbl-field col_5">
                <label for="txtLogUsername">@ViewLang.Username/@ViewLang.Nickname</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txtLogUsername" class="width-170" maxlength="30" data-val-required="@Messages.RequiredFieldError" />
            </div>
            <div class="submit width-auto col_3">
                <input id="btnLogSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
        <div class="filter-row"></div>
    </div>
</div>
<div id="divSmartPunterListContainer" class="display-none content-grid">
    <div id="divSmartPunterList" class="freegrid"></div>
</div>
<div id="divSmartPunterLogListContainer" class="display-none log-list content-grid">
    <div id="divSmartPunterLogList" class="freegrid"></div>
</div>
<div id="divDetailTemplate" class="display-none">
    <div class="detail-title">{0}</div>
    <div class="detail-table">
        <div class="row">
            <div class="detail-label first-cell">CustID</div>
            <div class="cust-cell">{1}</div>
            <div class="detail-label">@ViewLang.Remark</div>
            <div class="remark-cell">{2}</div>
            <div class="detail-label">@ViewLang.IP</div>
            <div class="ip-cell">{3}</div>
        </div>
        <div class="row last-row">
            <div class="detail-label first-cell">ErrCode</div>
            <div class="cust-cell">{4}</div>
            <div class="detail-label">ErrMsg</div>
            <div class="remark-cell">{5}</div>
            <div></div>
            <div></div>
        </div>
    </div>
</div>
@if (hasEditAccessRight)
{
    <div class="display-none">
        <div id="divSmartPunterForm" class="form expand-form">
            <div id="divErrorSuccessMsg" class="inline-message"></div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtNewUsername">@ViewLang.Username/@ViewLang.Nickname</label>
                </div>
                <div class="edit-field">
                    <input type="hidden" id="hdnCustID" />
                    <input type="text" id="txtNewUsername" class="width-200" maxlength="30" data-val-required="@Messages.RequiredFieldError" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="ddlRole">@ViewLang.Level<br /></label>
                </div>
                <div class="edit-field">
                    <select id="ddlRole" class="level-width">
                        <option value="4">@ViewLang.Super</option>
                        <option value="3">@ViewLang.Master</option>
                        <option value="2">@ViewLang.Agent</option>
                        <option value="1" selected>@ViewLang.Member</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtRemark">@ViewLang.Remark<br /><span class="optional">(@ViewLang.Optional)</span></label>
                </div>
                <div class="edit-field">
                    <textarea id="txtRemark" class="width-200" maxlength="200" rows="5" cols="65"></textarea>
                </div>
            </div>
            <div class="form-row button-row">
                <div class="lbl-field  normal-label"></div>
                <div class="edit-field">
                    <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Save" />
                    <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
                </div>
            </div>
        </div>
    </div>
}
@section Foot
{
    @Scripts.Render("~/scripts/manageSmartPunters")
    <script type="text/javascript">
        var labels = {
            Order: '#',
            Username: '@ViewLang.Username',
            Nickname: '@ViewLang.Nickname',
            Status: '@ViewLang.Status',
            Level: '@ViewLang.Level',
            Currency: '@ViewLang.Currency',
            Site: '@ViewLang.Site',
            Super: '@ViewLang.Super',
            Master: '@ViewLang.Master',
            Agent: '@ViewLang.Agent',
            AddedBy: '@ViewLang.AddedBy',
            AddedDate: '@ViewLang.AddedDate',
            Remark: '@ViewLang.Remark',
            Edit: '@ViewLang.Edit',
            Remove: '@ViewLang.Remove',
            AddSmartPunter: '@ViewLang.AddSMASmartPunter',
            EditSmartPunter: '@ViewLang.EditSMASmartPunter',
            FromDate: '@ViewLang.FromDate',
            ToDate: '@ViewLang.ToDate',
            LogID: '@ViewLang.LogID',
            LogDate: '@ViewLang.LogDate',
            EditedBy: '@ViewLang.EditedBy',
            Action: '@ViewLang.Action',
            Details: '@ViewLang.Details'
        };
        var messages = {
            InvalidValueError: '@Messages.InvalidValueError',
            UpdateSmartPunterSuccessfully: '@Messages.UpdateSmartPunterSuccessfully',
            AddSmartPunterSuccessfully: '@Messages.AddSmartPunterSuccessfully',
            RemoveSmartPunterConfirmationMessage: '@Messages.RemoveSmartPunterConfirmationMessage',
            RemoveSmartPunterSuccessfully: '@Messages.RemoveSmartPunterSuccessfully',
            ThereIsNoChange: '@Messages.ThereIsNoChange'
        };
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            Today: '@DateTime.Today.ToShortFormatedDate()'
        };
        var hasEditRight = '@hasEditAccessRight' === 'True';
    </script>
}