@{
    ViewBag.Title = ViewLang.ConfigureTOByEvent;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/configureTOByEvent")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
    <div class="header-button">
        <a href="#" id="lnkSport" class="green-button change-list"><span class="icon-list"></span>@ViewLang.Sport</a>
        <a href="#" id="lnkLeague" class="green-button change-list"><span class="icon-list"></span>@ViewLang.League</a>
        <a href="#" id="lnkMatch" class="green-button change-list"><span class="icon-list"></span>@ViewLang.Match</a>
    </div>
}
<div id="divSportContent" class="display-none content-grid sport-content">
    <div id="divSportTurnoverContainer" class="display-none">
        <div id="divSportTurnover" class="freegrid"></div>
    </div>
    <div id="divLeagueTurnoverContainer" class="display-none">
        <div id="divLeagueTurnover" class="freegrid"></div>
    </div>
    <div id="divMatchTurnoverContainer" class="display-none">
        <div id="divMatchTurnover" class="freegrid"></div>
    </div>
</div>
<div id="divLeagueContent" class="display-none">
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_2 align-right">
                    <label for="ddlSport">@ViewLang.Sport</label>
                </div>
                <div class="edit-field col_8 align-left">
                    <select id="ddlSport" class="combobox-autocomplete sport"></select>
                </div>
                <div class="lbl-field col_2 align-right">
                    <label for="ddlLeague">@ViewLang.League</label>
                </div>
                <div class="edit-field col_12 align-left">
                    <select id="ddlLeague" class="combobox-autocomplete league width-250"></select>
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
                </div>
            </div>
            <div class="filter-row"></div>
        </div>
    </div>
    <div id="divLeagueTurnoverContainer" class="content-grid display-none">
        <div id="divLeagueTurnover" class="freegrid"></div>
    </div>
    <div id="divMatchTurnoverContainer" class="content-grid display-none">
        <div id="divMatchTurnover" class="freegrid"></div>
    </div>
</div>
<div id="divMatchContent" class="display-none">
    <div class="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_2 align-right">
                    <label for="ddlSport">@ViewLang.Sport</label>
                </div>
                <div class="edit-field col_8 align-left">
                    <select id="ddlSport" class="combobox-autocomplete sport"></select>
                </div>
                <div class="lbl-field col_2 align-right">
                    <label for="ddlLeague">@ViewLang.League</label>
                </div>
                <div class="edit-field col_12 align-left">
                    <select id="ddlLeague" class="combobox-autocomplete league width-250"></select>
                </div>
                <div class="lbl-field col_3 align-right">
                    <label for="txtMatchCode">@ViewLang.MatchCode</label>
                </div>
                <div class="edit-field col_6 align-left">
                    <input type="text" id="txtMatchCode" />
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
                </div>
            </div>
            <div class="filter-row"></div>
        </div>
    </div>
    <div id="divMatchTurnoverContainer" class="content-grid display-none">
        <div id="divMatchTurnover" class="freegrid"></div>
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/configureTOByEvent")
    <script type="text/javascript">
        var labels = {
            Sport: '@ViewLang.Sport',
            Sports: '@ViewLang.Sports',
            League: '@ViewLang.League',
            Match: '@ViewLang.Match',
            Code: '@ViewLang.Code',
            Event: '@ViewLang.Event',
            EventDate: '@ViewLang.EventDate',
            Percentage: '@ViewLang.Percentage',
            Exception: '@ViewLang.Exception',
            RemoveException: '@ViewLang.RemoveException',
            Unlimited: '@ViewLang.Unlimited',
            OnlyShowExceptionSetting: '@ViewLang.OnlyShowExceptionSetting',
            AllLeagues: '@ViewLang.AllLeagues'
        };
        var messages = {
            NotShowAgain: '@Html.Raw(Messages.NotShowAgainMessage)',
            TurnoverInputInstruction: '@Messages.TurnoverInputInstruction',
            InvalidValueError: '@Messages.InvalidValueError',
            UpdatePercentageConfirmMessage: '@Messages.UpdatePercentageConfirmMessage',
            RemoveTurnoverExceptionConfirmMessage: '@Messages.RemoveTurnoverExceptionConfirmMessage'
        };
        var hasEditRight = '@ViewBag.HasEditRight' === 'True';
    </script>
}