@using Fanex.Nap.CMS.TurnoverControl.Resources;
@model bool
<div id="sma-turnover-container" class="freegrid display-none">
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        @if (Model)
                        {
                            <th>
                                <div class="table-cell col-checkbox">
                                    <input type="checkbox" id="checkbox-all" />
                                    <span class="ico-multipleEdit" title="@Labels.MultipleEditMaxTurnover" id="icon-edit-maxturnover"></span>
                                </div>
                            </th>
                        }
                        <th>
                            <div class="table-cell col-sma-name">
                                @Labels.UserName
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-level">
                                @Labels.Level</div>
                        </th>
                        <th>
                            <div class="table-cell col-currency">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col-member-turnover">
                                @Labels.Member_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-company-turnover">
                                @Labels.Company_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.Max_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-percentage-used">
                                @Labels.Percentage_Used</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="sma-turnover-content" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        @if (Model)
                        {
                            <th>
                                <div class="table-cell col-checkbox">
                                    <input type="checkbox" id="checkbox-all" />
                                </div>
                            </th>
                        }
                        <th>
                            <div class="table-cell col-sma-name">
                                @Labels.UserName
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-level">
                                @Labels.Level</div>
                        </th>
                        <th>
                            <div class="table-cell col-currency">
                                @Labels.Currency</div>
                        </th>
                        <th>
                            <div class="table-cell col-member-turnover">
                                @Labels.Member_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-company-turnover">
                                @Labels.Company_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.Max_Turnover</div>
                        </th>
                        <th>
                            <div class="table-cell col-percentage-used">
                                @Labels.Percentage_Used</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    @if (Model)
    {
        Html.RenderPartial("_MultipleEditMaxTOPopup");
    }
</div>
