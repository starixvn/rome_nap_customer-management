@using Fanex.NAP.CMS.Core.Resources;
@using Fanex.Nap.CMS.Infrastructure.Resources;
@model Fanex.Nap.CMS.BetRestriction.ViewModels.BetRestrictionViewModel
<div id="containerFormCurrencyManager" class="hidden">
    @using (Html.BeginForm("", "BetRestrictionSoccer", FormMethod.Post, new { id = "formCurrencyManager", @class = "form", @onsubmit = "return false;" }))
    {
        <div id="div-popupResult-message" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="ddlPopupCurrency">@ViewLang.Currency</label><span class="red float-right">*</span>
            </div>
            <div class="edit-field">
                @Html.DropDownList(
                    "ddlPopupCurrency",
                    (new List<SelectListItem> { new SelectListItem { Text = "Please select", Value = "", Selected = true } }).Union(Model.Currency),
                    new { @id = "ddlPopupCurrency" })

                <input id="txtPopupCurrency" type="text" readonly="readonly" disabled="disabled" />
                <input id="hidExchangeId" type="hidden" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="ddlPopupCurrencyType">@ViewLang.Type</label><span class="red float-right">*</span>
            </div>
            <div class="edit-field">
                <select id="ddlPopupCurrencyType">
                    <option value="" selected>Please select</option>
                    <option value="0">@Labels.All</option>
                    <option value="1">@Labels.Credit</option>
                    <option value="2">@Labels.Licensee</option>
                </select>
                <input id="hidCurrentType" type="hidden" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="selPopupCurrencyLiveBetAccept">@Labels.LiveBetAccept</label><span class="red float-right">*</span>
            </div>
            <div class="edit-field">
                <select id="selPopupCurrencyLiveBetAccept">
                    <option selected>Please select</option>
                    <option value="">@Labels.FollowUpperLevel</option>
                    @for (int i = -5; i <= 60; i++)
                    {
                        <option value="@i.ToString()">@i.ToString()</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="selPopupCurrencySeizeBetTicket">@Labels.SeizeBetTicket</label>
            </div>
            <div class="edit-field">
                <select id="selPopupCurrencySeizeBetTicket">
                    <option value="">@Labels.FollowUpperLevel</option>
                    <option selected value="0">None</option>
                    @for (int i = 10; i <= 100; i += 5)
                    {
                        <option value="@i.ToString()">@i.ToString() %</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="txtPopupCurrency8RMAccount">@ViewLang._8RMAccount</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtPopupCurrency8RMAccount" autocomplete="off" disabled="disabled" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="ckbCurrencyAccumulateBalance">@ViewLang.AccumulateBalance</label>
            </div>
            <div class="ckb-field edit-field">
                <input type="checkbox" id="ckbCurrencyAccumulateBalance" />
            </div>
        </div>
        <div class="form-row button-row">
            <div class="edit-field">
                <button type="button" id="btnCurrencySave" class="blue-button">@ViewLang.Save</button>
                <button type="button" id="btnCurrencyCancel" class="red-button">@ViewLang.Cancel</button>
            </div>
        </div>
    }
</div>
