@using Fanex.Nap.CMS.Customers.Resources
@model IEnumerable<Fanex.NAP.CMS.BetLimitControl.Models.BetLimitTypeModel>

<div class="display-none">
    <div id="frmUpd" class="form expand-form">
        <div id="msgUpd" class="inline-message"></div>
        <div class="form-row">
            <div class="lbl-field col-label">
                <label>@ViewLang.Username<span class="required-field">*</span></label>
            </div>
            <div class="edit-field">
                <label id="usernameUpdate"></label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field col-label">
                <label for="selBetLimitTypeUpdate">@ViewLang.BetLimitType<span class="required-field">*</span></label>
            </div>
            <div class="edit-field">
                <select id="selBetLimitTypeUpdate" class="bet-limit-type-select">
                    @foreach (var betLimitType in @Model)
                    {
                        <option value="@betLimitType.BetLimitTypeId">@betLimitType.BetLimitType</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field col-label">
                <label for="txtMaxPerMatchUpdate">@ViewLang.MaxPerMatch<span class="required-field">*</span></label>
            </div>
            <div class="edit-field">
                <input type="text" class="number-separator input-text-right" maxlength="21" id="txtMaxPerMatchUpdate" autocomplete="off" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field col-label">
                <label for="txtMaxBetUpdate">@ViewLang.MaxBet<span class="required-field">*</span></label>
            </div>
            <div class="edit-field">
                <input type="text" class="number-separator input-text-right" maxlength="21" id="txtMaxBetUpdate" autocomplete="off" />
            </div>
        </div>
        <div class="form-row float-right button-group">
            <div class="lbl-field normal-label col-label lbl-btn-group"></div>
            <div class="edit-field">
                <input type="button" id="btnSaveUpdate" class="blue-button" value="@Labels.Save" />
                <input type="button" id="btnCancelUpdate" class="red-button" value="@Labels.Cancel" />
            </div>
        </div>
    </div>
</div>