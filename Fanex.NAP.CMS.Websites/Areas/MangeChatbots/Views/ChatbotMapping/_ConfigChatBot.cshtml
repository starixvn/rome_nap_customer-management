@model Fanex.Nap.CMS.ManageChatbots.Models.ChatbotMapping.ChatBotsConfigModel
@using (Html.BeginForm("UpdateChatBotConfig", "ChatBotMapping", FormMethod.Post, new { id = "formChatBotConfig", @class = "form expand-form" }))
{
    <div id="config-chat-bot-popup">
        <div id="div-inlineMessage" class="inline-message"></div>
        <div class="container">
            <div class="col">
                <div>Bot SerVice:</div>
                <div>Username:</div>
                <div>Chatbot Name:</div>
            </div>
            <div class="col">
                <div id="BotSerVice"><b>Telegram</b></div>
                <div id="Username"><b>@Model.ChatBotModel.UserName</b></div>
                <div id="ChatBotName"><b>@Model.ChatBotModel.ChatBotName</b></div>
            </div>
            <div class="col">
                <div>Msg. Username:</div>
                <div>Sub Account:</div>
                <div>Status</div>
            </div>
            <div class="col">
                <div id="MsgUsername"><b>@Model.ChatBotModel.ChatID</b></div>
                <div id="SubAccount"><b>@Model.ChatBotModel.SubAccount</b></div>
                <div>
                    <span id="Status">Linked</span>
                    <btn>Unlink</btn>
                </div>
            </div>


        </div>
        <hr/>
        <div class="container">
            <div class="col">
                <div>Language:</div>
            </div>
            <div class="col">
                <select id="ddl-Language" class="combobox-autocomplete width-200"></select>
            </div>
        </div>
        <div>
            <button type="submit" class="submit">Save</button>
        </div>

        @*<div>
            <table>
                <tr>
                    <th>Functions/Notifications</th>
                    <th>Enable</th>
                </tr>
                <tr>
                    <td>Yesterday Win Loss Notification</td>
                    <td>Icon</td>
                </tr>
                <tr>
                    <td>Personal Message</td>
                    <td>
                        <div class="toggle-on-off status-on"/>'
                    </td>
                </tr>
            </table>
           <div>
                <button type="submit" class="submit">Save</button>
            </div>

        </div>*@
    </div>
}