@using Newtonsoft.Json
@using Fanex.Nap.CMS.Infrastructure.Extensions
@model Fanex.Nap.CMS.CustomerClass.ViewModels.SpreadViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.SpreadManagement;
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}

@section Head {
    @Styles.Render(CustomerClassBundlesConfig.SpreadStyles)
}

@section Foot {
    <script type="text/javascript">
        const resources = {
            title: "@Labels.Title",
            customerClass: "@Labels.CustomerClass",
            sportType: "@Labels.SportType",
            site: "@Labels.Site",
            currency: "@Labels.Currency",
            platform: "@Labels.Platform",
            spread: "@Labels.Spread",
            enable: "@Labels.Enable",
            action: "@Labels.Action",
            all: "@Labels.All",
            yes: "@Labels.Yes",
            no: "@Labels.No",
            requiredField: "@Labels.RequiredField",
            noData: "@Labels.NoData",
            uploadSiteSetting: "@Labels.UploadSpreadSetting",
            totalErrors: "@Labels.TotalErrors",
            notExcelFileError: "@Labels.NotExcelFileError",
        };
        const customerClassList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.CustomerClasses, jsonSettings))');
        const siteList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Sites, jsonSettings))');
        const currencyList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Currencies, jsonSettings))');
        const platforms = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Platforms, jsonSettings))');
        const sportList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.SportTypes, jsonSettings))');
    </script>
    @Scripts.Render(CustomerClassBundlesConfig.SpreadScripts)
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}

<div class="filter-bar">
    <form class="filter-form" id="formSearch">
        <div class="filter-row last-row">
            <div class="lbl-field col_4">
                <label>@Labels.CustomerClass</label>
            </div>
            <div class="edit-field col_8">
                <div id="ddlCustomerClasses"></div>
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.SportType</label>
            </div>
            <div class="edit-field col_7">
                @Html.DropDownList("sportType", Model.SportTypes.InsertAllItem(), new { @class = "combobox-autocomplete width-site", id = "ddlSportType" })
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.Spread</label>
            </div>
            <div class="edit-field col_4">
                <input id="filterSpread" type="text" />
            </div>
        </div>
        <div class="filter-row last-row">
            <div class="lbl-field col_4">
                <label>@Labels.Site</label>
            </div>
            <div class="edit-field col_8">
                <div id="ddlSites"></div>
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.Currency</label>
            </div>
            <div class="edit-field col_10">
                <div id="ddlCurrencies"></div>
            </div>
            <div class="submit width-auto">
                <button type="submit" class="submit">@Labels.Search</button>
                @if (Model.HasHostPermission)
                {
                    <button type="button" class="green-button" id="btnAdd">@Labels.Add</button>
                    <button type="button" class="green-button" id="btnUpload">@Labels.Upload</button>
                }
            </div>
        </div>
    </form>
</div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>

@if (Model.HasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @{
            Html.RenderPartial("~/Areas/CustomerClass/Views/Spread/_UploadForm.cshtml");
        }
    </div>
}