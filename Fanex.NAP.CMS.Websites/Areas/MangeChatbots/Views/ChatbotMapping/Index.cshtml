@using Fanex.NAP.CMS.Core.Resources
@using Fanex.Nap.CMS.ManageChatbots.AppStart
@using Fanex.Nap.CMS.ManageChatbots.Resources
@using Newtonsoft.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.Nap.CMS.ManageChatbots.ViewModels.ChatbotMapping.ChatBotMappingViewModel

@section Head
{
    @Styles.Render(ManageChatbotsBundleConfig.ChatbotMappingStyles)
}

@section Headline
{
    <div class="title">
        <div>
            <span class="curr">Chatbot Mapping</span>
        </div>
    </div>
}

<div class="filter-bar">
    @using (Html.BeginForm("SearchChatBots", "ChatBotMapping", FormMethod.Get, new { id = "formChatbotMapping", @class = "filter-form" }))
    {
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txt-chatID">@Labels.ChatID</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txt-chatID" class="width-160" autocomplete="off" maxlength="20" onkeydown="return CMS.forceNumericInput(event);"/>
            </div>
            <div class="lbl-field col_4">
                <label>@Labels.BotName</label>
            </div>
            <div class="edit-field col_7">
                @Html.DropDownList(
                    "ddlChatBotNames",
                    Model.ChatBotNames,
                    new { @id = "ddl-chatBotNames" })
            </div>
            <div class="lbl-field col_4">
                <label>@Labels.LinkingStatus</label>
            </div>
            <div class="edit-field col_6">
                <select id="ddl-linkingStatus" class="combobox-autocomplete width-80"></select>
            </div>
            <div class="lbl-field col_3">
                <label>@Labels.Currency</label>
            </div>
            <div class="edit-field col_8">
                @Html.DropDownList(
                    "ddlCurrency",
                    Model.Currencies,
                    new { @id = "ddl-currency" })
            </div>
            <div class="lbl-field width-auto col_6">
                <input type="checkbox" id="chk-subAccountsOnly"/>
                <label for="chk-subAccountsOnly">@Labels.SubAccountsOnly</label>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txt-userNameSubAccount">@Labels.UserNameSubAccount</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txt-userNameSubAccount" class="width-160" autocomplete="off" maxlength="50"/>
            </div>
            <div class="lbl-field col_4">
                <label>@Labels.Level</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-level" class="combobox-autocomplete width-120"></select>
            </div>
            <div class="lbl-field col_4">
                <label>@Labels.Status</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-status" class="combobox-autocomplete width-80"></select>
            </div>
            <div class="lbl-field col_2">
                <label>@Labels.Site</label>
            </div>
            <div class="edit-field col_8">
                <div id="ddl-site" class="multiselect" multiple="multiple">
                </div>
            </div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit" style="margin: 0;">@Labels.Search</button>
            </div>
        </div>
        <div class="filter-row"></div>
    }
</div>
<div id="div-result-message" class="inline-message"></div>
<div id="chatBots-list-container" class="content-grid">
    <div id="chatBots-list" class="freegrid display-none"></div>
</div>

@section Foot
{
    <script type="text/javascript">
      var jsonSites = @Html.Raw(Json.Encode(Model.Sites));
      var viewResources = {
           Symbol_No: '@Labels.Symbol_No',
           ChatBotName: '@Labels.ChatBotName',
           ChatID: '@Labels.ChatID',
           UserName: '@Labels.UserName',
           SubAccount: '@Labels.SubAccount',
           Error_InvalidValue: '@Messages.InvalidValueError',
           LinkingStatus: '@Labels.LinkingStatus',
           Language: '@Labels.Language',
           Level: '@Labels.Level',
           Currency: '@Labels.Currency',
           AccStatus: '@Labels.Status',
           Config: '@Labels.Config',    
           DateGMT4: '@Labels.DateGMT4',
           Site: '@Labels.Site',
      };
      
    </script>
    @Scripts.Render(ManageChatbotsBundleConfig.ChatbotMappingsScripts)
}