@using Fanex.Nap.CMS.Customers.AppStart
@{
    ViewBag.Title = ViewLang.BetLimitTypeControl;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render(CustomersBundlesConfig.BetLimitTypeControlStylePath)
}
@section Foot
{
    @Scripts.Render(CustomersBundlesConfig.BetLimitTypeControlScriptPath)
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar" isHost="@ViewBag.IsHost.ToString()">
    <div id="divFilterForm" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="selectProduct">@ViewLang.Product</label>
            </div>
            <div class="edit-field col_7">
                <select id="selectProduct" class="combobox-autocomplete"></select>
            </div>
            <div class="lbl-field col_3">
                <label for="selectSportType">@ViewLang.Sport</label>
            </div>
            <div class="edit-field col_7">
                <select id="selectSportType" class="combobox-autocomplete"></select>
            </div>
            <div class="lbl-field col_3">
                <label for="selectSport">@ViewLang.BetType</label>
            </div>
            <div class="edit-field col_9">
                <select id="selectBetType" class="combobox-autocomplete"></select>
            </div>
            <div class="lbl-field col_4">
                <label for="selectLiveIndicator">@ViewLang.Live/@ViewLang.NonLive</label>
            </div>
            <div class="edit-field col_5">
                <select id="selectLiveIndicator" class="combobox-autocomplete">
                    <option value="3">@ViewLang.All</option>
                    <option value="2">@ViewLang.Both</option>
                    <option value="1">@ViewLang.Live</option>
                    <option value="0">@ViewLang.NonLive</option>
                </select>
            </div>
            <div class="submit width-auto col_3">
                <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
    </div>
</div>
@if (ViewBag.IsHost)
{
    <div class="button-list clear-fix">
        <button type="button" class="blue-button" id="btnAdd">New Bet Limit Type</button>
    </div>
}
<div class="display-none content-grid">
    <div id="grid" class="freegrid"></div>
</div>
<div class="display-none" id="restrict-vip-title">
    <p>- If Restrict VIP = Yes then the VIP accounts will be applied the bet limit.</p>
    <p>- If Restrict VIP = No then the VIP accounts will not be applied the bet limit.</p>
</div>
@Html.Partial("_AddOrUpdate")