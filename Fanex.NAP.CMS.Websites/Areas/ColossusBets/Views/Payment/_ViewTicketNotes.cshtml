<div class="form expand-form" id="ticketNotesContainer">
    <div class="form-row">
        <table class="tblColossusBets">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@ColossusBetsLabels.Date</th>
                    <th>@ColossusBetsLabels.Author</th>
                    <th>@ColossusBetsLabels.Note</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="form-row button-row">
        <button type="button" class="red-button">@ColossusBetsLabels.Close</button>
    </div>
</div>