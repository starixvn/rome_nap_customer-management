@model Fanex.Nap.CMS.CustomerClass.ViewModels.PolicyViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Labels.PolicyManagement;
}

@section Head {
    @Styles.Render(CustomerClassBundlesConfig.PolicyStyles)
}

@section Foot {
    <script type="text/javascript">
        const resources = {
            ruleTitle: "@Labels.RuleTitle",
            criteria: "@Labels.Criteria",
            customerClass: "@Labels.CustomerClass",
            sportType: "@Labels.SportType",
            leagueGroup: "@Labels.LeagueGroup",
            isLive: "@Labels.IsLive",
            diffBalanceRatio: "@Labels.DiffBalanceRatio",
            betDelay: "@Labels.BetDelay",
            nextSuperSiteBetIntervalSec: "@Labels.NextSuperSiteBetIntervalSec",
            minMaxBetMPM: "@Labels.MinMaxBetMPM",
            repeatedBets: "@Labels.RepeatedBets",
            seizeBet: "@Labels.SeizeBet",
            enableParlay: "@Labels.EnableParlay",
            peakHourSpread: "@Labels.PeakHourSpread",
            enable: "@Labels.Enable",
            all: "@Labels.All",
            yes: "@Labels.Yes",
            no: "@Labels.No",
            addPolicySetting: "@Labels.AddPolicySetting",
            editPolicySetting: "@Labels.EditPolicySetting",
            selectAllFollowFilter: "@Labels.SelectAllFollowFilter",
            noData: "@Labels.NoData",
            requiredField: "@Labels.RequiredField"
        };
    </script>
    @Scripts.Render(CustomerClassBundlesConfig.PolicyScripts)
}

@section Headline {
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="note-box">
    <p class="float-left">* @Labels.PolicyManagementNote</p>
    @if (Model.HasHostPermission)
    {
        <button type="button" class="blue-button float-right" id="btnAddNew">@Labels.AddNewPolicy</button>
    }
</div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
@if (Model.HasHostPermission)
{
    <div id="divPopupContent" class="display-none">
        @{ Html.RenderPartial("~/Areas/CustomerClass/Views/Policy/_AddNewOrEditForm.cshtml", Model); }
    </div>
}
