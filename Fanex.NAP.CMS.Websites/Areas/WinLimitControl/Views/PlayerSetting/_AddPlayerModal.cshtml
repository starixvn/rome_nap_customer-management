@using (Html.BeginForm("SearchPlayer", "PlayerSetting", FormMethod.Post, new { id = "form-addplayer", @class = "form expand-form", area = "WinLimitControl" }))
{
    <div class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field width-60">
            <label>@WinLimitControlLabels.Username</label></div>
        <div class="edit-field">
             @Html.TextBox("txt-query", string.Empty, new { maxlength = "100" })
        </div>
        <div class="edit-field search-button">
            <button type="submit" class="blue-button">@WinLimitControlLabels.Search</button>
        </div>
    </div>
    <div class="form-row" id="tblWinLimit-container">
        <table class="tblWinLimit">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@WinLimitControlLabels.Game</th>
                    <th>@WinLimitControlLabels.PlayerWinLimit</th>
                    <th>@WinLimitControlLabels.CurrencyWinLimit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="form-row winlimit-note">
        <p class="wltitle">@WinLimitControlLabels.Note:</p>
        <p class="wlcontent">@WinLimitControlLabels.WinLimitNote</p>
    </div>
    <div class="form-row button-row">
        <button type="button" class="blue-button" id="button-addplayer">@WinLimitControlLabels.Save</button>
        <button type="button" class="red-button">@WinLimitControlLabels.Cancel</button>
    </div>
}