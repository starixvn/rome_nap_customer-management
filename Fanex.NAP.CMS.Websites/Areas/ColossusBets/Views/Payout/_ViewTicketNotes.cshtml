@using Fanex.Nap.CMS.ColossusBets.Models
@using Fanex.Nap.CMS.Infrastructure.Extensions
@model IList<TicketNote>
<div class="form-row">
    <table class="tblColossusBets tblTicketNote">
        <thead>
            <tr>
                <th>#</th>
                <th>@ColossusBetsLabels.Date</th>
                <th>@ColossusBetsLabels.Author</th>
                <th>@ColossusBetsLabels.Note</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr><td colspan="4" class="text-red">@Fanex.Nap.CMS.Infrastructure.Resources.Labels.Message_NoReportData</td></tr>
            }
            else
            {
                int number = 0;
                foreach (var note in Model)
                {
                    <tr>
                        <td class="width-20 align-center">@(++number)</td>
                        <td class="width-160 align-center">@note.Date</td>
                        <td class="width-120">@note.Author</td>
                        <td style="width: 400px;">@Html.Raw(note.Note.NewlinesToBr())</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="form-row button-row">
    <button type="button" class="red-button" onclick="CMS.closePopup()">@ColossusBetsLabels.Close</button>
</div>
