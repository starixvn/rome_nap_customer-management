@using (Html.BeginForm("RemoveReduceBL", "ProblemAccountCreditSite", FormMethod.Post, new { id = "formRemoveReduceBLMemmber", @class = "form" }))
{
    <input type="hidden" name="usernames" id="txt-usernames" value="" />
    <input type="hidden" name="level" id="txt-level" value="" />
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row">
        <p>@ProblemAccountResource.SelectedAccounts: <span class="bold" id="span-selectedAccounts"></span></p>
    </div>
    <div class="form-row">
        <p><span class="text-red">*</span> @ProblemAccountResource.RemoveReduceBLHint</p>
    </div>
    <div class="form-row button-row">
        <button type="submit" class="blue-button">@ProblemAccountResource.OK</button>
        <button type="button" class="red-button" id="btn-cancel">@ProblemAccountResource.Cancel</button>
    </div>
}
@using (Html.BeginForm("RemoveReduceBL", "ProblemAccountCreditSite", FormMethod.Post, new { id = "formRemoveReduceBLSMA", @class = "form" }))
{
    <input type="hidden" name="usernames" id="txt-usernames" value="" />
    <input type="hidden" name="level" id="txt-level" value="" />
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row min-height-25">
        <p>@ProblemAccountResource.SelectedAccounts: <span class="bold" id="span-selectedAccounts"></span></p>
    </div>
    <div class="form-row min-height-25">
        <p class="no-margin-bottom">@ProblemAccountResource.RemoveReduceBLFor</p>
    </div>
    <div class="form-row min-height-25">
        <div class="edit-field">
            <input type="radio" name="isAllDownlines" id="rdo-selectedAccounts" value="false" checked="checked" />
            <label for="rdo-selectedAccounts">@ProblemAccountResource.RemoveReduceBLForSelectedAccounts</label>
        </div>
    </div>
    <div class="form-row min-height-25">
        <div class="edit-field">
            <input type="radio" name="isAllDownlines" id="rdo-selectedAccountsAndDownlines" value="true" />
            <label for="rdo-selectedAccountsAndDownlines">@ProblemAccountResource.RemoveReduceBLForSelectedAccountsAndAllDownlines</label>
        </div>
    </div>
    <div class="form-row min-height-25">
        <p><span class="text-red">*</span> @ProblemAccountResource.RemoveReduceBLHint</p>
    </div>
    <div class="form-row button-row">
        <button type="submit" class="blue-button">@ProblemAccountResource.Save</button>
        <button type="button" class="red-button" id="btn-cancel">@ProblemAccountResource.Cancel</button>
    </div>
}