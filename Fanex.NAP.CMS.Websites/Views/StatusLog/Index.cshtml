@using Fanex.Nap.CMS.Infrastructure.Extensions;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewLang.StatusLog;
}
@section Head
{
    @Styles.Render("~/styles/credit-collection-summary")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="txt-code">@ViewLang.Code</label>
            </div>
            <div class="edit-field col_7">
                <input type="text" id="txt-code" />
            </div>
            <div class="submit width-auto col_4">
                <input id="btn-generate" type="button" class="submit" value="@ViewLang.Generate" />
            </div>
        </div>
    </div>
</div>
<div class="content-grid">
    <div id="div-report" class="freegrid display-none"></div>
</div>

@section Foot
{
    <script type="text/javascript">
        var viewResources = {
            LogID: "@ViewLang.LogID",
            LogDate: "@ViewLang.LogDate",
            EditedBy: "@ViewLang.EditedBy",
            Action: "@ViewLang.Action",
            Detail: "@ViewLang.Detail",
            Old: "@ViewLang.Old",
            New: "@ViewLang.New",
            StatusLog: "@ViewLang.StatusLog",

            Alert: "@ViewLang.Alert",
            Normal: "@ViewLang.Normal",
            Unused: "@ViewLang.Unused"
        };

    </script>
    @Scripts.Render("~/scripts/status-log")
}
