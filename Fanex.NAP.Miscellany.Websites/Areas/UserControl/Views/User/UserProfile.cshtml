@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.Core.Web
@model UpdateCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.User_Profile;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <div class="usertitle">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <div id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(c => c.FirstName)
                </div>
                <div class="edit-field col_10">
                    @Html.TextBoxFor(c => c.FirstName, new { @class = "userprofile" })
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(c => c.LastName)
                </div>
                <div class="edit-field col_10">
                    @Html.TextBoxFor(c => c.LastName, new { @class = "userprofile" })
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                    @Html.LabelFor(c => c.Email)
                </div>
                <div class="edit-field col_10">
                    @Html.TextBoxFor(c => c.Email, new { @class = "userprofile" })
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5"></div>
                <div class="edit-field col_10">
                    <div class="submit width-auto col_3">
                        <input type="submit" value="@ViewResources.Save" />
                    </div>
                    <div class="cancel width-auto col_3">
                        <input type="button" value="Cancel" onclick="Miscellany.navigateToRoot('', 0); return false;"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.GroupId)
}
@section Foot {
    @if (success)
     {
        <script type="text/javascript">
            $(function () {
                Miscellany.headlineMsgBox.showInfo('@ViewResources.Your_changes_were_saved!', { closeBtn: false });
            });
        </script>
    }
}