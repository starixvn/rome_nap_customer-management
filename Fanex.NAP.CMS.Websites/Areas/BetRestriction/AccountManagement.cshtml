@using Fanex.NAP.CMS.Core.Resources;
@using Fanex.Nap.CMS.Infrastructure.Resources;
<div id="containerFormAccountManager">
    @using (Html.BeginForm("AddAccount", "BetRestriction", FormMethod.Post, new { id = "formAccountManager", @class = "form display-none" }))
    {
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="txtPopupAccUsername" >@ViewLang.Username</label><span class="red float-right">*</span>
            </div>
            <div class="edit-field">
                <input type="text" id="txtPopupAccUsername" autocomplete="off" maxlength="30"  data-val-required="@Messages.RequiredFieldError" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="chkPopupAccLiveBetAccept">@Labels.LiveBetAccept</label><span class="red float-right">*</span>
            </div>
            <div class="edit-field">
                <select id="chkPopupAccLiveBetAccept">
                    <option value="">Please select</option>
                    @for (int i = -5; i <= 60; i++)
                    {
                        <option value="@i.ToString()">@i.ToString()</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="chkPopupAccSeizeBetTicket">@Labels.SeizeBetTicket</label>
            </div>
            <div class="edit-field">
                <select id="chkPopupAccSeizeBetTicket">
                    <option value="">None</option>
                    @for (int i = 10; i <= 100; i += 5)
                    {
                        <option value="@i.ToString()">@i.ToString() %</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="txtPopupAccMaxBet">@ViewLang.MaxBet</label><span id="noteInfoMessage" class="note-info-message"></span>
            </div>
            <div class="edit-field">
                <input type="text" id="txtPopupAccMaxBet" autocomplete="off" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="txtPopupAccMaxPerMatch">@ViewLang.MaxPerMatch</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtPopupAccMaxPerMatch" autocomplete="off" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field normal-label width-160">
                <label for="txtPopupAcc8RMAccount">@ViewLang._8RMAccount</label>
            </div>
            <div class="edit-field">
                <input type="text" id="txtPopupAcc8RMAccount" autocomplete="off" disabled="disabled" />
            </div>
        </div>
        <div class="form-row button-row">
            <div class="lbl-field normal-label width-120"></div>
            <div class="edit-field">
                <button type="button" id="btnAccSave" class="blue-button">@ViewLang.Save</button>
                <button type="button" id="btnAccCancel" class="red-button">@ViewLang.Cancel</button>
            </div>
        </div>
        <input id="hidCustId" type="hidden" />
    }
</div>
