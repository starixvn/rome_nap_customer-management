<head>
    <meta charset="utf-8" />
    <title>@ViewResources.Log_In</title>
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/style/login")
    @Scripts.Render("~/scripts/loginJS")
</head>
<body>
    <div id='not-supported-browser-panel' style="display: none">
        Your browser is no longer supported. Some parts will not work and you may experience
        problems.<br />
        If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
        browsing experience. Thank you!
    </div>
    @using (Html.BeginForm())
    {
        <div class="center ">
            <div id="login-box">
                <div id="msg">
                    <span id="inner-msg">@ViewBag.Message</span>
                </div>
                <div class="header">
                    <div class="welcome">
                    </div>
                    <div class="secure">
                    </div>
                </div>
                <div class="auth">
                    <input type="text" id="username" name="username" autocomplete="off" />
                    <input type="password" id="password" name="password" />
                    <input type="submit" id="submit" value="@ViewResources.Log_In" />
                </div>
                <div class="best-view">
                    <span>Best view in </span><span class="ff4">Firefox 4</span><span class="ie8">IE8</span>
                </div>
            </div>
        </div>
    }
