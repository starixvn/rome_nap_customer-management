@using Fanex.Nap.CMS.TurnoverControl.Resources;
@model bool
<div id="sma-turnover-container" class="freegrid display-none">
    <div class="col_header row-headers-background scroll-y">
        <div class="header-container">
            <table class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        @if (Model)
                        {
                            <th rowspan="2" class="th-multipleEdit-container">
                                <div class="table-cell col-checkbox">
                                    <input type="checkbox" id="checkbox-all" />
                                    <span class="ico-multipleEdit" title="@Labels.MultipleEditMaxTurnover" id="icon-edit-maxturnover"></span>
                                </div>
                            </th>
                        }
                        <th rowspan="2">
                            <div class="table-cell col-sma-name">
                                @Labels.UserName
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-level">
                                @Labels.Level
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-lock">
                                @Labels.GlobalSettingLock
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-lock">
                                @Labels.EventSettingLock
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-currency">
                                @Labels.Currency
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-member-turnover">
                                @Labels.TotalMemberTO
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-company-turnover">
                                @Labels.TotalHouseTO / @Labels.Exposure
                            </div>
                        </th>
                        <th colspan="5">
                            <div class="col-span-max-turnover">
                                @Labels.Max_Turnover / @Labels.Exposure
                            </div>
                        </th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.HDP_ML
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.OU
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels._1HHDP_1HML
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels._1HOU
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.Others
                            </div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="grid-container container">
        <div class="content-container">
            <table id="sma-turnover-content" class="grid-fixed-table col_header_content">
                <thead>
                    <tr>
                        @if (Model)
                        {
                            <th rowspan="2" class="th-multipleEdit-container">
                                <div class="table-cell col-checkbox">
                                    <input type="checkbox" id="checkbox-all" />
                                </div>
                            </th>
                        }
                        <th rowspan="2">
                            <div class="table-cell col-sma-name">
                                @Labels.UserName
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-level">
                                @Labels.Level
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-lock">
                                @Labels.GlobalSettingLock
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-lock">
                                @Labels.EventSettingLock
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-currency">
                                @Labels.Currency
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-member-turnover">
                                @Labels.TotalMemberTO
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="table-cell col-company-turnover">
                                @Labels.TotalHouseTO / @Labels.Exposure
                            </div>
                        </th>
                        <th colspan="5">
                            <div class="col-span-max-turnover">
                                @Labels.Max_Turnover / @Labels.Exposure
                            </div>
                        </th>
                    </tr>
                    <tr>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.HDP_ML
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.OU
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels._1HHDP_1HML
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels._1HOU
                            </div>
                        </th>
                        <th>
                            <div class="table-cell col-max-turnover">
                                @Labels.Others
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    @if (Model)
    {
        Html.RenderPartial("_MultipleEditMaxTOPopup");
    }
</div>
