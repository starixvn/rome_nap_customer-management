<div class="form" id="form-addNewRule">
    <div id="divErrorSuccessMsg" class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="txt-ruleTitle">@VREngineResource.RuleTitle</label>
        </div>
        <div class="edit-field">
            <input type="text" class="rule-title" id="txt-ruleTitle" autocomplete="off" maxlength="1000" />
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="txt-priorityOrder">@VREngineResource.PriorityOrder</label>
            <span class="text-red">*</span>
        </div>
        <div class="edit-field">
            <input type="text" class="width-60" id="txt-priorityOrder" autocomplete="off" maxlength="5" />
            <span class="priority-note">@VREngineResource.PriorityOrderRangeHint</span>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label>@VREngineResource.Criteria</label>
        </div>
    </div>
    <div id="div-criteriaContainer"></div>
    <div class="form-row adjustment-row">
        <span class="lbl-field">@VREngineResource.Adjustment</span>
        <div class="edit-field">
            <select class="combobox-autocomplete width-180" id="ddl-adjustment"></select>
            <div class="active-value">
                <input type="text" class="width-60 align-right" id="txt-adjustment" autocomplete="off" maxlength="7" />
                &nbsp;<span>%</span>
            </div>
        </div>
    </div>
    <div class="form-row">
        <span class="lbl-field">@VREngineResource.Active</span>
        <div class="edit-field">
            <select class="combobox-autocomplete width-180" id="ddl-active"></select>
        </div>
    </div>
    <div class="button-row">
        <button type="submit" class="blue-button" id="btn-addNewRule">@Labels.Submit</button>
        <button type="button" class="red-button" id="btn-cancel">@Labels.Cancel</button>
    </div>
</div>
