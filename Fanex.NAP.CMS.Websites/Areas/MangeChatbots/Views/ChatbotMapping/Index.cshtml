@using Fanex.NAP.CMS.Core.Resources
@using Fanex.Nap.CMS.ManageChatbots.AppStart
@using Fanex.Nap.CMS.ManageChatbots.Resources
@using Newtonsoft.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.Nap.CMS.ManageChatbots.ViewModels.ChatbotMapping.ChatBotMappingViewModel

@section Head
{
    @Styles.Render(ManageChatbotsBundleConfig.ChatbotMappingStyles)
}

@section Headline
{
    <div class="title">
        <div>
            <span class="curr">Chatbot Mapping</span>
        </div>
    </div>
}

<div class="filter-bar">
    @using (Html.BeginForm("SearchChatBots", "ChatBotMapping", FormMethod.Get, new { id = "formChatbotMapping", @class = "filter-form" }))
    {
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txt-messengerUserName">@Labels.MessengerUserName</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txt-messengerUserName" class="width-200" autocomplete="off" maxlength="50"/>
            </div>

            <div class="lbl-field col_3">
                <label>@Labels.Status</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-status" class="combobox-autocomplete width-100"></select>
            </div>

            <div class="lbl-field col_4">
                <label>@Labels.LinkingStatus</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-linkingStatus" class="combobox-autocomplete width-100"></select>
            </div>

            <div class="lbl-field col_3">
                <label>@Labels.Currency</label>
            </div>
            <div class="edit-field col_7">
                @Html.DropDownList(
                    "ddlCurrency",
                    Model.Currencies,
                    new { @id = "ddl-currency" })
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txt-userNameSubAccount">@Labels.UserNameSubAccount</label>
            </div>
            <div class="edit-field col_8">
                <input type="text" id="txt-userNameSubAccount" class="width-200" autocomplete="off" maxlength="50"/>
            </div>

            <div class="lbl-field col_7">
                <input type="checkbox" id="chk-subAccountsOnly"/>
                <label for="chk-subAccountsOnly" class="small-margin-left">@Labels.SubAccountsOnly</label>
            </div>

            <div class="lbl-field col_7">
                <label>@Labels.Level</label>
            </div>
            <div class="edit-field col_7">
                <select id="ddl-level" class="combobox-autocomplete width-100"></select>
            </div>

            <div class="lbl-field col_3">
                <label>@Labels.Site</label>
            </div>
            <div class="edit-field col_8">
                @Html.DropDownList(
                    "ddlSite",
                    Model.Sites,
                    new { @id = "ddl-site" })
            </div>

            <div class="submit width-auto col_3">
                <button type="submit" class="submit">@Labels.Search</button>
            </div>
        </div>
        <div class="filter-row"></div>
        <div class="filter-row">


        </div>
    }
</div>
@*//var currencies =@Html.Raw(JsonConvert.SerializeObject(Model.Currencies, Formatting.None));*@
<div id="div-result-message" class="inline-message"></div>
<div id="chatBots-list-container" class="content-grid">
    <div id="chatBots-list" class="freegrid display-none">
    </div>
</div>
<div id="divPopupContent" class="display-none">
    @{Html.RenderPartial("~/Areas/MangeChatbots/Views/ChatbotMapping/_ConfigChatBot.cshtml"); }
</div>

@section Foot
{
    <script type="text/javascript">
      
      var viewResources = {
           Symbol_No: '@Labels.Symbol_No',
           ChatBotName: '@Labels.ChatBotName',
           MessengerUserName: '@Labels.MessengerUserName',
           UserName: '@Labels.UserName',
           SubAccount: '@Labels.SubAccount',
           Error_InvalidValue: '@Messages.InvalidValueError',
           LinkingStatus: '@Labels.LinkingStatus',
           Language: '@Labels.Language',
           Level: '@Labels.Level',
           Currency: '@Labels.Currency',
           Status: '@Labels.Status',
           Config: '@Labels.Config',    
      };
      
    </script>
    @Scripts.Render(ManageChatbotsBundleConfig.ChatbotMappingsScripts)
}