@{
    ViewBag.Title = "Payout Function / Payout List / Payout Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/bundles/PayoutManagement/PayoutDetailStyles")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">
                Payout Function / <a href="javascript:;" id="payoutlist-link">Payout List</a> / Payout Details
            </span>
        </div>
    </div>
}
<div class="payout-detail">
    <div class="payout-row">
        <div class="payout-column">
            <div class="bold">@PayoutManagementLabels.RefNo:</div>
  	    </div>
        <div class="payout-column"><span id="refno"></span></div>
        <div class="payout-column width-120"></div>
        <div class="payout-column">
            <div class="bold">@PayoutManagementLabels.SiteLicensee:</div>
        </div>
        <div class="payout-column"><span id="sitelicensee"></span></div>
        @if ((bool)ViewBag.ViewSecuriyCodePermission)
        {
            <div class="payout-column width-120"></div>
            <div class="payout-column">
                <div class="bold seccode-inner" style="margin-top:4px;">@PayoutManagementLabels.SecurityCode</div>
  	        </div>
            <div class="payout-column">
                <div class="seccode-box seccode-inner">
                    <span id="seccode-text">******</span>
                    <button type="button" class="blue-button" id="seccode-button">@PayoutManagementLabels.Show</button>
                </div>
  	        </div>
        }
    </div>
    <div class="payout-row">
        <div class="payout-column">
            <div class="bold">@PayoutManagementLabels.Amount:</div>
  	    </div>
        <div class="payout-column"><span class="link" id="amount"></span></div>
        <div class="payout-column width-120"></div>
        <div class="payout-column">
            <div class="bold">@PayoutManagementLabels.Currency:</div>
        </div>
        <div class="payout-column"><span id="currency"></span></div>
    </div>
</div>
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
@if ((bool)ViewBag.UpdateTicketStatusPermission)
{
    <div class="clear-fix"></div>
    <div class="payout-detail">
        <div class="payout-row">
            <div class="payout-column">
                <div class="bold">@PayoutManagementLabels.Note:</div>
  	        </div>
        </div>
        <div class="payout-row">
            <div class="payout-column">
                <textarea id="ticketNote" rows="8" cols="100"></textarea>
  	        </div>
            <div class="payout-column">
                <div class="payout-row">
                    <div class="payout-column">
                        <div class="bold" style="margin-top:4px;">@PayoutManagementLabels.Status</div>
                    </div>
                    <div class="payout-column">
                        @Html.DropDownList("selectTicketStatus", (IEnumerable<SelectListItem>)ViewBag.Statuses, new { @class = "combobox-autocomplete width-140" })
                    </div>
                </div>
                <div class="payout-row">
                    <div class="payout-column"></div>
                    <div class="payout-column">
                        <button type="button" class="blue-button margin-15top" id="update-button">@PayoutManagementLabels.Update</button>
                    </div>
                </div>
  	        </div>
        </div>
    </div>
}
<div id="divModals" class="display-none">
    <div id="ticketDetailContainer"></div>
</div>

@section Foot {
    <script type="text/javascript">
        var payoutDetail = $.parseJSON('@Html.Raw(Model)');
        var currentStatus = @ViewBag.Status;
        var payoutManagementLabels = {
            Show: '@PayoutManagementLabels.Show',
            Hide: '@PayoutManagementLabels.Hide',
            Date: '@PayoutManagementLabels.Date',
            Status: '@PayoutManagementLabels.Status',
            Note: '@PayoutManagementLabels.Note',
            Handler: '@PayoutManagementLabels.Handler',
            ViewTicketDetailTitle: '@PayoutManagementLabels.ViewTicketDetailTitle'
        };
    </script>
    @Scripts.Render("~/bundles/PayoutManagement/PayoutDetailScripts")
}