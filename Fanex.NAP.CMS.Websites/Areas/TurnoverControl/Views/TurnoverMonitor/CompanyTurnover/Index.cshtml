@using Fanex.Nap.CMS.TurnoverControl.Resources;
@using Fanex.Nap.CMS.Infrastructure.Controllers;
@using Fanex.NAP.Core.Business;
@using Fanex.Nap.CMS.Infrastructure;
@using Fanex.Nap.CMS.TurnoverControl.Models.TurnoverMonitor;
@using Newtonsoft.Json;
@model List<TurnoverBalance>
@{
    ViewBag.Title = Labels.TurnoverMonitor_CompanyTurnover_Title;
    var companyTurnover = JsonConvert.SerializeObject(Model);
}
