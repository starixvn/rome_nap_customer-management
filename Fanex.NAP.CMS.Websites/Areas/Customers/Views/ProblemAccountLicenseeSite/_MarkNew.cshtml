@model Fanex.Nap.CMS.Customers.ViewModels.ProblemAccountLicenseeSite.IndexLicenseeSiteViewModel
@using (Html.BeginForm("MarkNew", "ProblemAccountLicenseeSite", FormMethod.Post, new { id = "formMarkNew", @class = "form" }))
{
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field padding-top12">
            <label for="txt-usernames">@ProblemAccountResource.Usernames<span class="text-red">*</span>@ProblemAccountCreditDepositResource.SeperatedByComma</label>
        </div>
        <div class="edit-field">
            <textarea rows="7" name="usernames" id="txt-usernames"></textarea>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field padding-top12">
            <label>@ProblemAccountResource.Reason<span class="text-red">*</span></label>
        </div>
        <div class="edit-field">
            @Html.DropDownList("reason", Model.MarkNewReasons, new { id = "ddl-reason", @class = "combobox-autocomplete width-250" })
        </div>
    </div>
    <div class="form-row divUpdateReason">
        <div class="column width-250">
            <div class="lbl-field width-250 padding-top12">
                <label>@ProblemAccountResource.Reason<span class="text-red">*</span></label>
            </div>
            <div class="edit-field width-250">
                @Html.DropDownList("preventiveAction", Model.MarkNewPreventiveActions, new { id = "ddl-preventiveAction", @class = "combobox-autocomplete width-180" })
            </div>
        </div>
        <div class="voidWinningOption column width-250 display-none">
            <div class="lbl-field width-250 padding-top12">
                <label>@ProblemAccountResource.Time</label>
            </div>
            <div class="edit-field width-250">
                @Html.DropDownList("voidTime", Model.VoidWinningTimes, new { id = "ddl-time", @class = "combobox-autocomplete width-180" })
            </div>
        </div>
        <div class="voidWinningOption column width-190 display-none">
            <div class="lbl-field width-190 padding-top12">
                <label>@ProblemAccountResource.LimitAmount</label>
            </div>
            <div class="edit-field width-190">
                <input type="text"
                       class="align-right width-160 clearable"
                       autocomplete="off"
                       maxlength="13"
                       name="limitAmount"
                       placeholder="@ProblemAccountResource.Unlimited"
                       id="txt-limitAmount" />
                <span class="note-info-message" title="@ProblemAccountResource.VoidWinningTicketLimitAmountHint"></span>
            </div>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field padding-top12">
            <label for="txt-comment">@ProblemAccountResource.Comment</label>
        </div>
        <div class="edit-field">
            <textarea rows="5" name="comment" id="txt-comment"></textarea>
        </div>
    </div>
    <div class="form-row button-row">
        <button type="submit" class="blue-button">@ProblemAccountResource.Save</button>
        <button type="button" class="red-button" id="btn-cancel">@ProblemAccountResource.Cancel</button>
    </div>
}
