@using Fanex.Nap.CMS.WinLimitControl.Models.CurrencySetting
@model IList<WinLimitEntity>
<div class="grid-title">
    <div class="grid-title-label">Virtual Sports - Currency Win Limit Setting</div>
</div>
<table class="tblWinLimit">
    <thead>
        <tr>
            <th class="width-30">#</th>
            <th class="width-170">@WinLimitControlLabels.Currency</th>
            <th class="width-200">@WinLimitControlLabels.WinLimit</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="nodata">There is no data</td></tr>
        }
        else
        {
            int number = 0;
            foreach (var setting in Model)
            {
                <tr>
                    <td class="align-center">@(++number)</td>
                    <td class="align-center">@setting.Currency.Name</td>
                    <td class="align-right">@setting.MaxWinLimit</td>
                </tr>    
            }
        }
    </tbody>
</table>