@{
    var hasEditAccessRight = (bool)ViewBag.HasEditAccessRight;

    ViewBag.Title = ViewLang.ConfigureSMATOByEvent;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/configureSMATOByEvent")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div class="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3 align-right">
                <label for="ddlSport">@ViewLang.Sport</label>
            </div>
            <div class="edit-field col_8 align-left">
                <select id="ddlSport" class="combobox-autocomplete"></select>
            </div>
            <div class="lbl-field col_2 align-right">
                <label for="ddlLeague">@ViewLang.League</label>
            </div>
            <div class="edit-field col_12 align-left">
                <select id="ddlLeague" class="combobox-autocomplete width-250"></select>
            </div>
            <div class="submit width-auto col_4">
                <input id="btnSearch" type="button" class="submit" value="@ViewLang.Search" />
            </div>
        </div>
        <div class="filter-row"></div>
    </div>
</div>
<div class="display-none content-grid">
    <div id="divSMAMaxTORate" class="freegrid"></div>
</div>
@if (hasEditAccessRight)
{
    <div class="display-none">
        <div id="divNewSMATOForm" class="form expand-form">
            <div id="divErrorSuccessMsg" class="inline-message"></div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtNewSMAName">@ViewLang.Event</label>
                </div>
                <div class="edit-field">
                    <input type="text" id="txtEvent" class="width-200" disabled />
                    <input type="hidden" id="hdnEvent" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtNewSMAName">@ViewLang.SMAName</label>
                </div>
                <div class="edit-field">
                    <input type="text" id="txtNewSMAName" class="width-200" data-val-required="@Messages.RequiredFieldError" />
                </div>
            </div>
            <div class="form-row">
                <div class="lbl-field">
                    <label for="txtMaxTORate">@ViewLang.MaxTORate</label>
                </div>
                <div class="edit-field">
                    <input type="text" id="txtMaxTORate" class="width-200" maxlength="7" data-val-required="@Messages.RequiredFieldError" />
                    <div class="insert-instruction">@Messages.TurnoverInputInstruction.Replace("\\", string.Empty)</div>
                </div>
            </div>
            <div class="form-row button-row">
                <div class="lbl-field  normal-label"></div>
                <div class="edit-field">
                    <input type="button" id="btnSave" class="blue-button" value="@ViewLang.Save" />
                    <input type="button" id="btnCancel" class="red-button" value="@ViewLang.Cancel" />
                </div>
            </div>
        </div>
    </div>
}
@section Foot
{
    @Scripts.Render("~/scripts/configureSMATOByEvent")
    <script type="text/javascript">
        var labels = {
            SMAName: '@ViewLang.SMAName',
            Level: '@ViewLang.Level',
            Currency: '@ViewLang.Currency',
            GivenCredit: '@ViewLang.GivenCredit',
            MaxTORate: '@ViewLang.MaxTORate',
            MaxTOAmount: '@ViewLang.MaxTOAmount',
            Unlimited: '@ViewLang.Unlimited',
            Action: '@ViewLang.Action',
            Remove: '@ViewLang.Remove',
            AddSMA: '@ViewLang.AddSMA',
            MatchCode: '@ViewLang.MatchCode',
            Date: '@ViewLang.Date',
            ConfigureSMATOByEvent: '@ViewLang.ConfigureSMATOByEvent'
        };
        var messages = {
            NotShowAgain: '@Html.Raw(Messages.NotShowAgainMessage)',
            TurnoverInputInstruction: '@Messages.TurnoverInputInstruction',
            InvalidValueError: '@Messages.InvalidValueError',
            ProceedConfirmMessage: '@Messages.ProceedConfirmMessage',
            RemoveSettingConfirmMessage: '@Messages.RemoveSettingConfirmMessage',
            RemoveSettingSuccessfully: '@Messages.RemoveSettingSuccessfully',
            UpdateSettingSuccessfully: '@Messages.UpdateSettingSuccessfully',
            AddSMATOSuccessfully: '@Messages.AddSMATOSuccessfully'
        };
        var hasEditRight = '@hasEditAccessRight' === 'True';
    </script>
}