@using Fanex.Nap.CMS.Infrastructure.Extensions;
@{
    ViewBag.Title = "Payout Function / Payout List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime currentDate = DateTime.Today;
}
@section Head {
    @Styles.Render("~/bundles/PayoutManagement/PayoutListStyles")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
@using (Html.BeginForm("GetPayoutList", "PayoutList", FormMethod.Post, new { id = "form-filterTicket", @class = "filter-bar", area = "ColossusBets" }))
{
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label for="username">@ColossusBetsLabels.Username</label>
            </div>
            <div class="edit-field col_8">
                @Html.TextBox("username", string.Empty, new { maxlength = "50", autocomplete = "off" })
            </div>
            <div class="lbl-field col_4">
                <label>@ColossusBetsLabels.SiteLicensee</label>
            </div>
            <div class="edit-field col_8">
                <div id="siteslicensees"></div> 
            </div>
            <div class="lbl-field col_3">
                <label>@ColossusBetsLabels.Product</label>
            </div>
            <div class="edit-field col_8">
                <div id="products"></div> 
            </div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit">@ColossusBetsLabels.Submit</button>
            </div>
        </div>
        <div class="filter-row">
            <div class="lbl-field col_3">
                <label>@ColossusBetsLabels.Status</label>
            </div>
            <div class="edit-field col_8">
                <div id="statuses"></div>
            </div>
            <div id="fromtodate-picker"></div>
        </div>
    </div>
}
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
<div id="divModals" class="display-none">
@{
    <div id="ticketDetailContainer"></div>
}
</div>
@section Foot {
    <script type="text/javascript">
        var filterData = $.parseJSON('@Html.Raw(Model)');
        var currentDate = '@currentDate.ToShortFormatedDateWithSlash()',
            initFromDate = '@currentDate.AddYears(-1).ToShortFormatedDateWithSlash()';
        var colossusBetsLabels = {
            From: '@ColossusBetsLabels.From',
            To: '@ColossusBetsLabels.To',
            Product: '@ColossusBetsLabels.Product',
            Username: '@ColossusBetsLabels.Username',
            SiteLicensee: '@ColossusBetsLabels.SiteLicensee',
            Date: '@ColossusBetsLabels.Date',
            RefNo: '@ColossusBetsLabels.RefNo',
            Currency: '@ColossusBetsLabels.Currency',
            Amount: '@ColossusBetsLabels.Amount',
            Status: '@ColossusBetsLabels.Status',
            Detail: '@ColossusBetsLabels.Detail',
            SecurityCode: '@ColossusBetsLabels.SecurityCode',
            ViewTicketDetailTitle: '@ColossusBetsLabels.ViewTicketDetailTitle',
            UpdateTicketStatusTitle: '@ColossusBetsLabels.UpdateTicketStatusTitle',
            ViewTicketNoteTitle: '@ColossusBetsLabels.ViewTicketNoteTitle'
        };
    </script>
    @Scripts.Render("~/bundles/PayoutManagement/PayoutListScripts")
}