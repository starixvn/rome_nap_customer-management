@{
    ViewBag.Title = "Virtual Setting Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/bundles/virtualsettingcontrol/virtualsettingmonitor-styles")
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
@using (Html.BeginForm("Search", "VirtualSettingMonitor", FormMethod.Get, new { id = "form-virtualsetting", @class = "filter-bar", area = "VirtualSettingControl" }))
{
    <div class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_2">
                <label>Sport</label>
            </div>
            <div class="edit-field col_8">
                <select id="sport" class="combobox-autocomplete width-100">
                    <option value="-1" selected>All</option>
                    <option value="1">Soccer</option>
                    <option value="2">Other Sports</option>
                </select>
            </div>
            <div class="lbl-field col_3">
                <label>Rate</label>
            </div>
            <div class="edit-field col_6">
                <select id="rate" class="combobox-autocomplete width-60">
                    <option value="-5" selected>-5</option>
                    @{
                        for (var i = -10; i >= -90; i += -5)
                        {                            
                            <option value="@i">@i</option>
                        }
                    }
                </select>
            </div>
            <div class="lbl-field col_3">
                <label>Top Rows</label>
            </div>
            <div class="edit-field col_6">
                <select id="toprows" class="combobox-autocomplete width-60">
                    <option value="10">10</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
            </div>
            <div class="lbl-field col_3">
                <label>Won Period</label>
            </div>
            <div class="edit-field col_6">
                <select id="wonperiod" class="combobox-autocomplete width-100">
                    <option value="1">Last 1 Month</option>
                    <option value="2">Last 2 Months</option>
                    <option value="3" selected>Last 3 Months</option>
                </select>
            </div>
            <div class="submit width-auto col_3">
                <button type="submit" class="submit">Search</button>
            </div>
        </div>
    </div>
}
<div class="content-grid">
    <div class="freegrid display-none" id="freegrid"></div>
</div>
<div id="divModals" class="display-none">
    @{ Html.RenderPartial("~/Areas/VirtualSettingControl/Views/VirtualSettingMonitor/ViewHistoryModal.cshtml"); }
</div>
@section Foot
{
    <script type="text/javascript">
        window.rootUrl = $('#CMSRoot').val();
    </script>
    <!--@Scripts.Render("~/bundles/virtualsettingcontrol/virtualsettingmonitor-scripts")
    -->
    <script src="~/Areas/VirtualSettingControl/Views/VirtualSettingMonitor/Scripts/ViewHistoryModal.js" type="text/javascript"></script>
    <script src="~/Areas/VirtualSettingControl/Views/VirtualSettingMonitor/Scripts/VirtualSettingMonitor.js" type="text/javascript"></script>
    <script src="~/Scripts/Libs/jQuery/jquery.cookie.min.js" type="text/javascript"></script>
}