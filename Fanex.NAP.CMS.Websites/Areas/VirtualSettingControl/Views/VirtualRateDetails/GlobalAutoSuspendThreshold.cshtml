﻿@using Newtonsoft.Json;
@using Fanex.NAP.CMS.Core.Resources
@using Fanex.Nap.CMS.VirtualSettingControl
@using Fanex.Nap.CMS.VirtualSettingControl.Resources
@{
    ViewBag.Title = ESportsResource.ESports_GlobalAutoSuspendThreshold;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/bundles/virtual-rate-details/index-styles")
}
@section Foot
{
    <script type="text/javascript">
        var resources = {
            Message_NoReportData: "@Fanex.Nap.CMS.Infrastructure.Resources.Labels.Message_NoReportData",
            CopyToAll: "@ViewLang.CopyToAll"
        };
        var model = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model, new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore }))');
    </script>
    @Scripts.Render(VirtualSettingControlBundleConfig.ESports_GlobalAutoSuspendThresholdScript)
}
@section Headline
{
    <div class="title">
        <div><span class="curr">@ViewBag.Title</span></div>
    </div>
}
<div class="no-filter"></div>
<div id="report-container" class="margin-bottom">
    <div>
        <button type="button" class="submit btn-submit-changes">@ViewLang.SubmitAllChanges</button>
    </div>
    <div class="content-grid">
        <div id="virtual-rate-report-freegrid-grid-title" class="grid-title">
            <div class="grid-title-label" id="report-tile">@ESportsResource.GlobalAutoSuspendThreshold</div>
            <div class="grid-toolbox">
                <input type="button" id="btn-export-excel" class="btnExcel" title="@ViewLang.Export">
            </div>
        </div>
        <table id="tbl-virtual-rate-report" class="tbl-report">
            <thead>
                <tr>
                    <th class="col-group">
                        <button type="button" class="submit btn-view-compact-mode" id="btn-view-compact-mode">@ViewLang.ViewCompactMode</button>
                        <button type="button" class="submit display-none btn-view-full-mode" id="btn-view-full-mode">@ViewLang.ViewFullMode</button>
                        <span class="ico-collapse" id="ico-collapse"></span>
                    </th>
                    <th class="col-nonlive">@ViewLang.NonLive</th>
                    <th class="col-live">@ViewLang.Live</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div>
        <button type="button" class="submit btn-submit-changes">@ViewLang.SubmitAllChanges</button>
    </div>
</div>