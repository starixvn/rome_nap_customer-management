@using Fanex.Nap.CMS.ColossusBets.Models
@using Fanex.Nap.CMS.ColossusBets.Constants
@model TicketDetailReport
@helper FormatWinLoss(decimal winloss) {
    <div @(winloss > 0 ? string.Empty : "class=text-red")>@winloss.ToString("N2")</div>
}

@if (Model.CBAuthorization.ErrorCode != 0)
{
    <div class="form expand-form float-left ticketColossusBets">@Model.CBAuthorization.ErrorMsg</div>    
}
else
{
    <iframe class="form expand-form float-left ticketColossusBets"
        src="@string.Format(ColossusBetsConst.ColossusBetsAPITicketsURL, Model.BetId, Model.CBAuthorization.Data.Authorization)">
    </iframe>
}
<div class="form expand-form float-right">
    <div class="form-row">
        <p>@Model.Own</p>
        <p>@Model.Sold</p>
    </div>
    <div class="form-row">
        <table class="tblColossusBets">
            <thead>
                <tr>
                    <th>@ColossusBetsLabels.Date</th>
                    <th>@ColossusBetsLabels.TransactionType</th>
                    <th>@ColossusBetsLabels.WinLoss</th>
                    <th>@ColossusBetsLabels.Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TicketDetails.Count == 0)
                {
                    <tr><td colspan="4" class="text-red">@Fanex.Nap.CMS.Infrastructure.Resources.Labels.Message_NoReportData</td></tr>
                }
                else
                {
                    foreach (var detail in Model.TicketDetails)
                    {
                        <tr>
                            <td>@detail.Date</td>
                            <td>@detail.TransactionType</td>
                            <td>@FormatWinLoss(detail.WinLoss)</td>
                            <td>@detail.Status</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="2" class="align-right bold">@ColossusBetsLabels.Total</td>
                        <td colspan="2" class="bold">@FormatWinLoss(Model.TotalWinLoss)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>