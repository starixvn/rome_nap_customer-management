<div class="form expand-form" id="div-ViewHistory">
    <div class="form-row freetable-container">
        <table class="freetable-header">
            <colgroup>
                <col width="40px" /> 
                <col width="160px" /> 
                <col width="90px" /> 
                <col width="110px" />
                <col width="110px" />
                <col width="80px" />
                <col width="110px" />
                <col width="16px" />
            </colgroup>
            <thead>
                <tr>
                    <th>#</th>
                    <th>@WinLimitControlLabels.Date</th>
                    <th>@WinLimitControlLabels.WinLimit</th>
                    <th>@WinLimitControlLabels.WinningAmount</th>
                    <th>@WinLimitControlLabels.PercentageUsed</th>
                    <th>@WinLimitControlLabels.Action</th>
                    <th>@WinLimitControlLabels.ProceededBy</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
        </table>
        <div class="freetable-content">
            <table id="freegrid-history">
                <colgroup>
                    <col width="40px" />
                    <col width="160px" />
                    <col width="90px" />
                    <col width="110px" />
                    <col width="110px" />
                    <col width="80px" />
                    <col width="110px" />
                </colgroup>
                <tbody></tbody>
            </table>
        </div>
    </div>
    <div class="form-row button-row">
        <button type="button" class="red-button" onclick="CMS.closePopup()">@WinLimitControlLabels.Close</button>
    </div>
</div>