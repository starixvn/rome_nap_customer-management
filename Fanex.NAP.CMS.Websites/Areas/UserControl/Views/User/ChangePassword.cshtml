@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.Core.Web
@using Fanex.NAP.CMS.Core.Resources
@model UpdatePasswordCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewResources.Change_Password;
}
@section Headline {
    <div class="title">
        <div>
            <span>@HttpContext.Current.User.Identity.Name / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <div class="form w120 user-control" id="divPassword">
        <div id="divErrorSuccessMsg" class="inline-message"></div>
        <div id="divValidationSummary" class="display-none">
            @Html.ValidationSummary()
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.OldUserPwd)
            </div>
            <div class="edit-field">
                @Html.PasswordFor(
                    m => m.OldUserPwd,
                    new
                    {
                        data_val_required = Messages.RequiredFieldError,
                        data_val_length = Messages.PasswordMinLengthError,
                        data_min_length = 5
                    })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.UserPwd)
            </div>
            <div class="edit-field">
                @Html.PasswordFor(
                    m => m.UserPwd,
                    new
                    {
                        data_val_required = Messages.RequiredFieldError,
                        data_val_length = Messages.PasswordMinLengthError,
                        data_min_length = 5
                    })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.ConfirmUserPwd)
            </div>
            <div class="edit-field">
                @Html.PasswordFor(
                    m => m.ConfirmUserPwd,
                    new
                    {
                        data_val_required = Messages.RequiredFieldError,
                        data_val_length = Messages.PasswordMinLengthError,
                        data_val_not_match = Messages.PasswordDoesNotMatch,
                        data_min_length = 5
                    })
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                <input type="submit" id="btnSubmit" value="@ViewResources.Save" class="blue-button" />
                <input type="button" value="Cancel" onclick="CMS.navigateToRoot('', 0); return false;" class="red-button"/>
            </div>
        </div>
    </div>
}
@section Foot {
    <script type="text/javascript">
        var isSuccess = '@success' === 'True';
        var form = $('#divPassword');
        var serverError = $('#divValidationSummary');
        var msgArea = $('#divErrorSuccessMsg', form);
        var validateMatchedPass = function () {
            var newPass = form.find('#UserPwd');
            var confirmPass = form.find('#ConfirmUserPwd');
            var err = confirmPass.attr('data-val-not-match');

            if (newPass.val() !== confirmPass.val()) {
                Validator.showError(confirmPass, err, 'w');
                return false;
            } else {
                return true;
            }
        };

        $(function () {
            if (isSuccess) {
                CMS.showInlineInfoMsg('@ViewResources.Your_changes_were_saved!', msgArea);
            } else if (serverError.find('li:first').text() !== '') {
                CMS.showInlineErrorMsg(serverError.html(), msgArea);
            }

            form.find('#btnSubmit').click(function () {
                if (!Validator.validateForm(form, 'w')) {
                    return false;
                } else if (!validateMatchedPass()) {
                    return false;
                }
            });
        });
    </script>
}