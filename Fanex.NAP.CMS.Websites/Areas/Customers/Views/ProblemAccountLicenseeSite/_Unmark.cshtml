@using (Html.BeginForm("Unmark", "ProblemAccountLicenseeSite", FormMethod.Post, new { id = "formUnmarkMember", @class = "form" }))
{
    <div id="div-inlineMessage" class="inline-message"></div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="txt-usernames">@ProblemAccountResource.MultipleMembers<span class="text-red">*</span>@ProblemAccountResource.SeperatedByComma</label>
        </div>
        <div class="edit-field">
            <textarea rows="7" name="usernames" maxlength="4000" required id="txt-usernames"></textarea>
        </div>
    </div>
    <div class="form-row">
        <p class=""><span class="text-red">*</span> @ProblemAccountResource.UnmarkHint</p>
    </div>
    <div class="form-row button-row">
        <button type="submit" class="blue-button">@ProblemAccountResource.OK</button>
        <button type="button" class="red-button" id="btn-cancel">@ProblemAccountResource.Cancel</button>
    </div>
}
