@using System.Linq;
@using Fanex.Nap.CMS.Infrastructure.Resources;
@using Fanex.NAP.CMS.Core.Resources;
@model Fanex.Nap.CMS.BetRestriction.ViewModels.BetRestrictionViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/BetRestrictionManagement")
}
@section Headline
{
    <div class="title">
        <div>
            <span class="curr">@ViewLang.OnOffBetRestriction</span>
        </div>
    </div>
}
<div class="width-609">
    <div class="free-row"><input type="button" id="btnSubmit" class="submit" value="@ViewLang.Submit" /></div>
    <div class="free-row"></div>
    <div class="display-none content-grid">
        <div id="grdAccount" class="freegrid"></div>
        <div class="free-row"></div>
        <div id="grdSite" class="freegrid"></div>
        <div class="free-row"></div>
        <div id="grdCurrency" class="freegrid"></div>
    </div>
</div>
@section Foot
{
    @Scripts.Render("~/scripts/BetRestrictionManagement")
    <script type="text/javascript">
        var labels = {
        };
        var messages = {
            UpdateSuccess: '@ViewLang.UpdateSuccessfull',
            NothingChanged: '@Messages.NothingChanged'
        };
    </script>
}
